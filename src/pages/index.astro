---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
---

<Base title="Irina Moldovan · Digital Designer and Developer">
  <main>
    <Hero>
      <Header slot="header" />
    </Hero>

    <!-- Next section ("Good looks and good experiences") comes in the next step.
         This spacer only leaves room for the photo that runs on past the hero. -->
    <section id="about" class="next-placeholder" aria-hidden="true"></section>
  </main>
</Base>

<style>
  .next-placeholder {
    height: calc(560 * var(--u));
  }

  @media (max-width: 899px) {
    .next-placeholder {
      height: 80px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';

import irina from '../assets/home/irina-cutout.png';
import camera from '../assets/home/pink-camera.png';

import StarPinkLg from '../assets/home/svg/star-pink-lg.svg';
import StarOutlineLg from '../assets/home/svg/star-outline-lg.svg';
import StarPinkSm from '../assets/home/svg/star-pink-sm.svg';
import StarOutlineSm from '../assets/home/svg/star-outline-sm.svg';
import StarPinkMd from '../assets/home/svg/star-pink-md.svg';
import StarOutlineMd from '../assets/home/svg/star-outline-md.svg';
import PhotoFill from '../assets/home/svg/photo-fill.svg';
import PhotoOutlineA from '../assets/home/svg/photo-outline-a.svg';
import PhotoOutlineB from '../assets/home/svg/photo-outline-b.svg';

/*
  Coordinates below are Figma pixels from the 1440px "1.0 Home page" frame,
  measured from the top-left of the grid area each layer lives in.
  x/y = centre of the layer, w = its width, r = its tilt.
  m = [x, y, w] of the same layer in the phone frame (518:676, 393px wide), for layers the phone has.
*/
const layer = (x: number, y: number, w: number, r = 0, m?: [number, number, number]) =>
  `--x:${x};--y:${y};--w:${w};--r:${r}deg` + (m ? `;--mx:${m[0]};--my:${m[1]};--mw:${m[2]}` : '');
---

<section class="hero" aria-label="Introduction" data-section="hero">
  <slot name="header" />

  <!-- Title area: black paper plate, "HI, I'M IRINA.", stars, floating tags -->
  <div class="hero__title-area" data-drift="-120">
    <!-- The paper is its own layer, so it can wipe in without moving the plate's tilt point -->
    <span class="layer hero__plate" data-layer="title-plate" data-intro style={layer(351, 285.5, 641, -2.67, [198.19, 582.47, 415.17])}>
      <span class="hero__plate-paper" data-layer="title-plate-paper"></span>
    </span>
    <h1 class="layer hero__title" id="hero-title" data-layer="title" data-intro style={layer(361.3, 287.4, 600, -2.67, [204.48, 587.09, 269])}>
      Hi, I’m Irina.
    </h1>

    <span class="layer layer--svg" data-layer="title-star-left" data-intro style={layer(83.2, 290.4, 37.79, -4.26, [45.64, 592.13, 18])}><StarPinkMd data-depth="12" /></span>
    <span class="layer layer--svg" data-layer="title-star-left-outline" data-intro style={layer(84.3, 289.2, 37.79, -4.26, [46.17, 591.56, 18])}><StarOutlineMd data-depth="12" /></span>
    <span class="layer layer--svg" data-layer="title-star-right" data-intro style={layer(623.2, 269.4, 37.79, -4.26, [343.64, 577.13, 18])}><StarPinkMd data-depth="12" /></span>
    <span class="layer layer--svg" data-layer="title-star-right-outline" data-intro style={layer(624.3, 268.2, 37.79, -4.26, [344.17, 576.56, 18])}><StarOutlineMd data-depth="12" /></span>

    <span class="layer layer--svg hero__desktop-only" data-layer="sparkle-big" data-intro style={layer(663.2, 91.8, 56.35)}><StarPinkLg data-depth="12" /></span>
    <span class="layer layer--svg hero__desktop-only" data-layer="sparkle-big-outline" data-intro style={layer(665, 90.2, 56.35)}><StarOutlineLg data-depth="12" /></span>
    <span class="layer layer--svg hero__desktop-only" data-layer="sparkle-small" data-intro style={layer(683.4, 71, 22.62)}><StarPinkSm data-depth="12" /></span>
    <span class="layer layer--svg hero__desktop-only" data-layer="sparkle-small-outline" data-intro style={layer(684.1, 70.3, 22.62)}><StarOutlineSm data-depth="12" /></span>

    <Tag name="tag-coding-top" text="{ Coding }" x={393.5} y={-8.6} w={84.83} rotate={-13.31} intro="travel" class="hero__tag" />
    <Tag name="tag-experience-left" text="{ Experience Design }" x={225.1} y={111.9} w={156.34} rotate={4.15} intro="travel" class="hero__tag" />
    <Tag name="tag-visual-left" text="{ Visual Design }" x={484.7} y={118.3} w={121.12} rotate={-3.15} intro="travel" class="hero__tag" />
  </div>

  <!-- Dark band with the subtitle -->
  <span class="hero__band" data-layer="band" data-intro aria-hidden="true"></span>
  <!-- The brackets and the text are separate layers, so the tag can open on load -->
  <p class="hero__subtitle" data-layer="subtitle" data-intro><span class="hero__bracket" data-layer="subtitle-open">&lt;</span><span class="hero__subtitle-text" data-layer="subtitle-text">I’m a Digital Designer and Developer</span><span class="hero__bracket" data-layer="subtitle-close">&gt;</span></p>

  <!-- Internship tag, overlapping the bottom of the band -->
  <div class="hero__tag-area" data-drift="-60">
    <Tag
      name="tag-internship"
      text="{ currently searching for an internship }"
      x={463.97}
      y={7.9}
      w={409.68}
      h={51}
      rotate={-3.15}
      size="lg"
      paper="var(--c-green)"
      intro="hang"
      class="hero__internship"
    />
  </div>

  <!--
    Visual: photo cutout + outlines + camera. The photo is ONE piece that runs
    on past the hero into the About section (it's 885px tall in Figma).
  -->
  <div class="hero__visual" data-drift="-40">
    <span class="cutout cutout--outline-b" data-layer="photo-outline-back" data-intro data-depth="4"><PhotoOutlineB /></span>
    <span class="cutout cutout--fill" data-layer="photo-yellow" data-intro data-depth="4"><PhotoFill /></span>
    <span class="cutout cutout--outline-a" data-layer="photo-outline-front" data-intro data-depth="4"><PhotoOutlineA /></span>
    <Image
      class="cutout cutout--photo"
      data-layer="photo"
      data-intro
      data-depth="4"
      src={irina}
      alt="Irina, cut out like a collage, wearing a long beige coat"
      widths={[300, 600, 900]}
      sizes="(max-width: 767px) min(64vw, 308px), 292px"
      loading="eager"
    />
    <!-- The image is its own layer, so it can swing in from its corner without moving the camera's tilt point -->
    <span class="layer hero__camera" data-layer="camera" data-intro style={layer(264.2, 239.1, 496.69, -6.13, [212.44, 184.79, 330.84])}>
      <Image
        class="hero__camera-image"
        data-layer="camera-image"
        data-depth="4"
        src={camera}
        alt=""
        widths={[500, 735]}
        sizes="(max-width: 767px) min(84vw, 404px), 497px"
        loading="eager"
      />
    </span>

    <Tag name="tag-coding-camera" text="{ Coding }" x={37.2} y={277.4} w={84.83} rotate={-13.31} intro="grow" class="hero__tag" />
    <Tag name="tag-visual-camera" text="{ Visual Design }" x={404.3} y={284.3} w={121.12} rotate={-3.15} intro="grow" class="hero__tag" />
    <Tag name="tag-experience-camera" text="{ Experience Design }" x={364} y={447.4} w={156.34} rotate={3.25} intro="grow" class="hero__tag" />
  </div>
</section>

<style>
  /* ---------- Desktop and tablet (768px and up): grid areas on the 1440 Figma frame ---------- */
  /*
    The middle four columns are the 1440 Figma frame (94 + 699 + 528 + 119).
    The outer 1fr columns are 0 up to 1440px and split the extra width above it,
    so on wide screens the design stays exactly as it is at 1440, centred.
    Only the dark band runs edge to edge, like it does in the Figma frame.
  */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns:
      1fr calc(94 * var(--u)) calc(699 * var(--u)) calc(528 * var(--u))
      minmax(0, calc(119 * var(--u))) 1fr;
    grid-template-rows: auto calc(368 * var(--u)) calc(115 * var(--u)) calc(72 * var(--u));
    grid-template-areas:
      '.    header header header header .'
      '.    .      title  visual .      .'
      'band band   band   band   band   band'
      '.    .      tag    .      .      .';
  }

  .hero :global(.site-header) {
    grid-area: header;
  }

  .hero__title-area {
    grid-area: title;
    position: relative;
    z-index: 4;
  }

  .hero__band {
    grid-area: band;
    background: var(--c-ink);
    z-index: 1;
  }

  .hero__subtitle {
    grid-row: band;
    grid-column: title;
    align-self: center;
    margin: 0;
    font-family: var(--f-serif);
    font-size: calc(40 * var(--u));
    line-height: 1.2;
    color: var(--c-light);
    white-space: nowrap;
    z-index: 2;
  }

  .hero__bracket,
  .hero__subtitle-text {
    display: inline-block;
  }

  .hero__tag-area {
    grid-area: tag;
    position: relative;
    z-index: 2;
  }

  /*
    The visual starts in the title row and keeps going down past the band.
    It overlaps the band, so it can't be its own rectangle in grid-template-areas:
    it uses the lines of the areas it spans (top of "title" to bottom of "tag").
  */
  .hero__visual {
    /* the photo stack's unit: one Figma pixel, smaller on phones */
    --vu: var(--u);
    grid-column: visual;
    grid-row: title-start / tag-end;
    align-self: start;
    position: relative;
    height: calc(1040 * var(--u));
    margin-bottom: calc(-1040 * var(--u));
    z-index: 3;
  }

  /* ---------- Generic positioned layer ---------- */
  .layer {
    --k: var(--u);
    position: absolute;
    left: calc(var(--x) * var(--k));
    top: calc(var(--y) * var(--k));
    width: calc(var(--w) * var(--k));
    translate: -50% -50%;
    rotate: var(--r);
  }

  .layer--svg :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero__plate {
    height: calc(139.19 * var(--k));
  }

  .hero__plate-paper {
    position: absolute;
    inset: 0;
    background: var(--c-ink);
  }

  .hero__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(70 * var(--k));
    line-height: 1;
    color: var(--c-light);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  /* Photo stack: positioned from its top-left corner like in Figma */
  .cutout {
    position: absolute;
    left: calc(var(--cx) * var(--vu));
    top: calc(var(--cy) * var(--vu));
    width: calc(var(--cw) * var(--vu));
    height: auto;
  }

  .cutout :global(svg) {
    width: 100%;
    height: auto;
  }

  .cutout--outline-b { --cx: 64.75; --cy: 143.75; --cw: 316.5; }
  .cutout--fill      { --cx: 74;    --cy: 148;    --cw: 314; }
  .cutout--outline-a { --cx: 77.75; --cy: 147.75; --cw: 316.5; }
  .cutout--photo     {
    --cx: 90; --cy: 153; --cw: 292.04;
    filter: drop-shadow(calc(-4.83 * var(--vu)) calc(3.86 * var(--vu)) calc(3.86 * var(--vu)) oklch(26.16% 0.0296 267.48 / 0.1));
  }

  .hero__camera {
    display: block;
  }

  .hero__camera-image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(calc(-6 * var(--u)) calc(6 * var(--u)) calc(4 * var(--u)) oklch(26.16% 0.0296 267.48 / 0.1));
  }

  .hero__visual :global(.tag) {
    z-index: 2;
  }

  /*
    The title tags sit behind the plate, the title and the stars. On page load they
    start hidden under the plate and travel out to where they are now.
  */
  .hero__title-area :global(.tag) {
    z-index: -1;
  }

  /* The internship tag reacts to hover, so it takes the pointer (it isn't a link) */
  .hero__tag-area :global(.hero__internship .tag__body) {
    pointer-events: auto;
  }

  /*
    ---------- Phone (< 768px), Figma 518:676 ----------
    One 393px frame (--hm is one of its pixels, see below), centred above 480px like the desktop above 1440px.
    Every collage container starts at the frame's top-left corner, so each layer uses its Figma
    position: the centre of its bounding box (for a tilted layer, Figma's x / y is its own corner). The band runs edge to edge. The photo, the camera and the tags around it sit under the
    band, the plate, the title and the internship tag, as in Figma.
  */
  @media (max-width: 767px) {
    .hero {
      /*
        The hero's own phone unit: one Figma pixel, but smaller on short screens, so everything down
        to the internship sign (y 726 in Figma, plus 16px) fits on the first screen. svh is the
        screen height with the browser bars showing. The header keeps --m.
      */
      --hm: var(--m);
      --hm: min(var(--m), calc(100svh / 742));
      grid-template-columns: 1fr calc(393 * var(--hm)) 1fr;
      grid-template-rows: calc(615.7 * var(--hm)) calc(52.85 * var(--hm)) calc(331.45 * var(--hm));
      grid-template-areas:
        '.    top    .'
        'band band   band'
        '.    bottom .';
    }

    /* The header keeps its full phone size, across the band's width, centred */
    .hero :global(.site-header) {
      grid-column: band;
      grid-row: top;
      justify-self: center;
      align-self: start;
      width: calc(393 * var(--m));
    }

    .hero__title-area,
    .hero__tag-area,
    .hero__visual {
      grid-column: top;
      grid-row: top-start / bottom-end;
      align-self: stretch;
    }

    .hero__visual { z-index: 1; }
    .hero__band { z-index: 2; }
    .hero__subtitle { z-index: 3; }
    .hero__title-area { z-index: 4; }
    .hero__tag-area { z-index: 5; }

    .hero__desktop-only,
    .hero__title-area :global(.tag) {
      display: none;
    }

    .layer {
      --k: var(--hm);
      left: calc(var(--mx) * var(--hm));
      top: calc(var(--my) * var(--hm));
      width: calc(var(--mw) * var(--hm));
    }

    /* Figma: 415.17 x 73.72, tilted -2.67deg */
    .hero__plate {
      height: calc(73.72 * var(--hm));
    }

    /* Figma: Boldonse 38px */
    .hero__title {
      font-size: calc(38 * var(--hm));
    }

    /* Figma: Bona Nova 22px, centred on the band */
    .hero__subtitle {
      grid-area: band;
      justify-self: center;
      font-size: calc(22 * var(--hm));
    }

    /*
      The photo stack is the desktop one at 0.8633 of its size (252.11px wide instead of 292).
      The container starts 15.48px left of the frame and 100.83px down, so the photo lands at
      x 62.22, y 232.91 with the desktop offsets.
    */
    .hero__visual {
      --vu: calc(0.8633 * var(--hm));
      height: auto;
      margin: calc(100.83 * var(--hm)) 0 0 calc(-15.48 * var(--hm));
    }

    /* Figma: 330.84px wide (0.666 of the desktop camera), so its shadow is 0.666 of it too */
    .hero__camera-image {
      filter: drop-shadow(calc(-4 * var(--hm)) calc(4 * var(--hm)) calc(2.66 * var(--hm)) oklch(26.16% 0.0296 267.48 / 0.1));
    }

    /* The tags around the camera: the desktop size, at their phone positions and tilts */
    .hero__visual :global(.tag) {
      --k: var(--hm);
    }

    .hero__visual :global([data-layer='tag-visual-camera']) {
      left: calc(299.24 * var(--hm));
      top: calc(81.57 * var(--hm));
      rotate: 5.23deg;
    }

    .hero__visual :global([data-layer='tag-coding-camera']) {
      left: calc(60.44 * var(--hm));
      top: calc(210.6 * var(--hm));
    }

    .hero__visual :global([data-layer='tag-experience-camera']) {
      left: calc(237.43 * var(--hm));
      top: calc(288.53 * var(--hm));
    }

    /* Figma: 366.55 x 45.63, 0.8947 of the desktop tag, centred at x 201.53, y 693.35 */
    .hero__tag-area :global(.hero__internship) {
      --k: calc(0.8947 * var(--hm));
      left: calc(201.53 * var(--hm));
      top: calc(693.35 * var(--hm));
    }
  }
</style>

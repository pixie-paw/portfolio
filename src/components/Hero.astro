---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';

import irina from '../assets/home/irina-cutout.png';
import camera from '../assets/home/pink-camera.png';

import StarPinkLg from '../assets/home/svg/star-pink-lg.svg';
import StarOutlineLg from '../assets/home/svg/star-outline-lg.svg';
import StarPinkSm from '../assets/home/svg/star-pink-sm.svg';
import StarOutlineSm from '../assets/home/svg/star-outline-sm.svg';
import StarPinkMd from '../assets/home/svg/star-pink-md.svg';
import StarOutlineMd from '../assets/home/svg/star-outline-md.svg';
import PhotoFill from '../assets/home/svg/photo-fill.svg';
import PhotoOutlineA from '../assets/home/svg/photo-outline-a.svg';
import PhotoOutlineB from '../assets/home/svg/photo-outline-b.svg';

/*
  Coordinates below are Figma pixels from the 1440px "1.0 Home page" frame,
  measured from the top-left of the grid area each layer lives in.
  x/y = centre of the layer; mx/my = the same for the mobile layout.
*/
const layer = (x: number, y: number, w: number, r = 0, mx = x, my = y) =>
  `--x:${x};--y:${y};--w:${w};--r:${r}deg;--mx:${mx};--my:${my}`;
---

<section class="hero" aria-label="Introduction" data-section="hero">
  <slot name="header" />

  <!-- Title area: black paper plate, "HI, I'M IRINA.", stars, floating tags -->
  <div class="hero__title-area">
    <span class="layer hero__plate" data-layer="title-plate" style={layer(351, 285.5, 641, -2.67, 345, 175)}></span>
    <h1 class="layer hero__title" data-layer="title" style={layer(361.3, 287.4, 600, -2.67, 350, 177)}>
      Hi, I’m Irina.
    </h1>

    <span class="layer layer--svg" data-layer="title-star-left" style={layer(83.2, 290.4, 37.79, -4.26, 77, 180)}><StarPinkMd /></span>
    <span class="layer layer--svg" data-layer="title-star-left-outline" style={layer(84.3, 289.2, 37.79, -4.26, 78, 179)}><StarOutlineMd /></span>
    <span class="layer layer--svg" data-layer="title-star-right" style={layer(623.2, 269.4, 37.79, -4.26, 617, 159)}><StarPinkMd /></span>
    <span class="layer layer--svg" data-layer="title-star-right-outline" style={layer(624.3, 268.2, 37.79, -4.26, 618, 158)}><StarOutlineMd /></span>

    <span class="layer layer--svg" data-layer="sparkle-big" style={layer(663.2, 91.8, 56.35, 0, 655, 35)}><StarPinkLg /></span>
    <span class="layer layer--svg" data-layer="sparkle-big-outline" style={layer(665, 90.2, 56.35, 0, 657, 33)}><StarOutlineLg /></span>
    <span class="layer layer--svg" data-layer="sparkle-small" style={layer(683.4, 71, 22.62, 0, 675, 14)}><StarPinkSm /></span>
    <span class="layer layer--svg" data-layer="sparkle-small-outline" style={layer(684.1, 70.3, 22.62, 0, 676, 13)}><StarOutlineSm /></span>

    <Tag name="tag-coding-top" text="{ Coding }" x={393.5} y={-8.6} w={84.83} rotate={-13.31} class="hero__tag" />
    <Tag name="tag-experience-left" text="{ Experience Design }" x={225.1} y={111.9} w={156.34} rotate={4.15} class="hero__tag" />
    <Tag name="tag-visual-left" text="{ Visual Design }" x={484.7} y={118.3} w={121.12} rotate={-3.15} class="hero__tag" />
  </div>

  <!-- Dark band with the subtitle -->
  <span class="hero__band" data-layer="band" aria-hidden="true"></span>
  <p class="hero__subtitle" data-layer="subtitle">&lt;I’m a Digital Designer and Developer&gt;</p>

  <!-- Internship tag, overlapping the bottom of the band -->
  <div class="hero__tag-area">
    <Tag
      name="tag-internship"
      text="{ currently searching for an internship }"
      x={463.97}
      y={7.9}
      w={409.68}
      h={51}
      rotate={-3.15}
      size="lg"
      class="hero__internship"
    />
  </div>

  <!--
    Visual: photo cutout + outlines + camera. The photo is ONE piece that runs
    on past the hero into the About section (it's 885px tall in Figma).
  -->
  <div class="hero__visual">
    <span class="cutout cutout--outline-b" data-layer="photo-outline-back"><PhotoOutlineB /></span>
    <span class="cutout cutout--fill" data-layer="photo-yellow"><PhotoFill /></span>
    <span class="cutout cutout--outline-a" data-layer="photo-outline-front"><PhotoOutlineA /></span>
    <Image
      class="cutout cutout--photo"
      data-layer="photo"
      src={irina}
      alt="Irina, cut out like a collage, wearing a long beige coat"
      widths={[300, 600, 900]}
      sizes="(max-width: 899px) 45vw, 292px"
      loading="eager"
    />
    <Image
      class="layer hero__camera"
      data-layer="camera"
      src={camera}
      alt=""
      widths={[500, 735]}
      sizes="(max-width: 899px) 70vw, 497px"
      loading="eager"
      style={layer(264.2, 239.1, 496.69, -6.13)}
    />

    <Tag name="tag-coding-camera" text="{ Coding }" x={37.2} y={277.4} w={84.83} rotate={-13.31} class="hero__tag" />
    <Tag name="tag-visual-camera" text="{ Visual Design }" x={404.3} y={284.3} w={121.12} rotate={-3.15} class="hero__tag" />
    <Tag name="tag-experience-camera" text="{ Experience Design }" x={364} y={447.4} w={156.34} rotate={3.25} class="hero__tag" />
  </div>
</section>

<style>
  /* ---------- Desktop (≥ 900px): grid areas on the 1440 Figma frame ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: calc(94 * var(--u)) calc(699 * var(--u)) calc(528 * var(--u)) 1fr;
    grid-template-rows: auto calc(368 * var(--u)) calc(115 * var(--u)) calc(72 * var(--u));
    grid-template-areas:
      'header header header header'
      '.      title  visual .'
      'band   band   band   band'
      '.      tag    .      .';
  }

  .hero :global(.site-header) {
    grid-area: header;
  }

  .hero__title-area {
    grid-area: title;
    position: relative;
    z-index: 4;
  }

  .hero__band {
    grid-area: band;
    background: var(--c-ink);
    z-index: 1;
  }

  .hero__subtitle {
    grid-row: band;
    grid-column: 2 / 3;
    align-self: center;
    margin: 0;
    font-family: var(--f-serif);
    font-size: calc(40 * var(--u));
    line-height: 1.2;
    color: var(--c-light);
    white-space: nowrap;
    z-index: 2;
  }

  .hero__tag-area {
    grid-area: tag;
    position: relative;
    z-index: 2;
  }

  /* The visual starts in the title row and keeps going down past the band. */
  .hero__visual {
    grid-column: visual;
    grid-row: 2 / 5;
    align-self: start;
    position: relative;
    height: calc(1040 * var(--u));
    margin-bottom: calc(-1040 * var(--u));
    z-index: 3;
  }

  /* ---------- Generic positioned layer ---------- */
  .layer {
    --k: var(--u);
    position: absolute;
    left: calc(var(--x) * var(--k));
    top: calc(var(--y) * var(--k));
    width: calc(var(--w) * var(--k));
    translate: -50% -50%;
    rotate: var(--r);
  }

  .layer--svg :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero__plate {
    height: calc(139.19 * var(--k));
    background: var(--c-ink);
  }

  .hero__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(70 * var(--k));
    line-height: 1;
    color: var(--c-light);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  /* Photo stack: positioned from its top-left corner like in Figma */
  .cutout {
    position: absolute;
    left: calc(var(--cx) * var(--u));
    top: calc(var(--cy) * var(--u));
    width: calc(var(--cw) * var(--u));
    height: auto;
  }

  .cutout :global(svg) {
    width: 100%;
    height: auto;
  }

  .cutout--outline-b { --cx: 64.75; --cy: 143.75; --cw: 316.5; }
  .cutout--fill      { --cx: 74;    --cy: 148;    --cw: 314; }
  .cutout--outline-a { --cx: 77.75; --cy: 147.75; --cw: 316.5; }
  .cutout--photo     {
    --cx: 90; --cy: 153; --cw: 292.04;
    filter: drop-shadow(calc(-4.83 * var(--u)) calc(3.86 * var(--u)) calc(3.86 * var(--u)) rgb(30 36 51 / 0.1));
  }

  .hero__camera {
    height: auto;
    filter: drop-shadow(calc(-6 * var(--u)) calc(6 * var(--u)) calc(4 * var(--u)) rgb(30 36 51 / 0.1));
  }

  .hero__visual :global(.tag) {
    z-index: 2;
  }


  /* ---------- Mobile suggestion (< 900px): stacked, same collage pieces ---------- */
  @media (max-width: 899px) {
    .hero {
      /* 690 Figma px fit the screen between 16px gutters */
      --u: calc((100vw - 2 * var(--gutter)) / 690);
      grid-template-columns: var(--gutter) 1fr var(--gutter);
      grid-template-rows: auto calc(260 * var(--u)) auto calc(80 * var(--u)) auto;
      grid-template-areas:
        'header header header'
        '.      title  .'
        'band   band   band'
        '.      tag    .'
        '.      visual .';
      row-gap: 0;
    }

    .hero__title-area {
      margin-top: 12px;
    }

    .layer {
      left: calc(var(--mx) * var(--k));
      top: calc(var(--my) * var(--k));
    }

    .hero__subtitle {
      grid-column: 2;
      padding: 14px 0;
      font-size: max(18px, calc(40 * var(--u)));
      white-space: normal;
    }

    .hero__tag-area :global(.tag) {
      --k: calc(var(--u) * 1.3);
      left: 50%;
      top: calc(10 * var(--u));
    }

    .hero__title-area :global(.tag),
    .hero__visual :global(.tag) {
      --k: calc(var(--u) * 1.6);
    }

    .hero__title-area :global([data-layer='tag-coding-top']) {
      left: calc(410 * var(--u));
      top: calc(25 * var(--u));
    }

    .hero__title-area :global([data-layer='tag-experience-left']) {
      left: calc(165 * var(--u));
      top: calc(50 * var(--u));
    }

    .hero__title-area :global([data-layer='tag-visual-left']) {
      left: calc(540 * var(--u));
      top: calc(95 * var(--u));
    }

    .hero__visual {
      grid-row: visual;
      grid-column: visual;
      width: calc(528 * var(--u));
      justify-self: center;
      height: calc(1040 * var(--u));
      margin-bottom: 0;
      margin-top: calc(-120 * var(--u));
    }

  }
</style>

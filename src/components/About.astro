---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { WAVE_POINTS, WAVE_TEXT, smoothPath, shiftPoints, lengthUpTo } from '../data/wave';

import typewriter from '../assets/home/typewriter.png';

import StarPinkLg from '../assets/home/svg/star-pink-lg.svg';
import StarOutlineLg from '../assets/home/svg/star-outline-lg.svg';
import StarPinkSm from '../assets/home/svg/star-pink-sm.svg';
import StarOutlineSm from '../assets/home/svg/star-outline-sm.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
  Coordinates are Figma pixels from the 1440px "1.0 Home page" frame,
  measured from the top-left of this section (Figma y 720, where the hero ends).
  x/y = centre of the layer.
*/
const SECTION_TOP = 720;
const layer = (x: number, y: number, w: number, r = 0) =>
  `--x:${x};--y:${y - SECTION_TOP};--w:${w};--r:${r}deg`;

// The blue wave and its words, shared with the About me page (src/data/wave.ts).
// In Figma the text runs along the same curve, 146.5px lower, starting at x -195.
const TEXT_OFFSET_Y = 146.5;
const TEXT_START_X = -195;

const wavePath = smoothPath(WAVE_POINTS, SECTION_TOP);
// The text path covers the whole wave, so the flowing text fills wide screens too
const textPath = smoothPath(shiftPoints(WAVE_POINTS, 0, TEXT_OFFSET_Y), SECTION_TOP);
// Without the script, the text starts where it does in Figma (x -195): about this far along the path
const textStartOffset = lengthUpTo(WAVE_POINTS, TEXT_START_X);

// The SVG's own box, in Figma px relative to the frame (wide enough for 2560px screens)
const WAVE_BOX = { x: -800, y: 380, w: 3040, h: 1000 };


const SKILLS = [
  { heading: 'Design tools', lines: ['Photoshop · Illustrator · Figma', 'After Effects · Blender'] },
  { heading: 'Experience design', lines: ['User research · Usability testing', 'Wireframing & prototyping'] },
  {
    heading: 'Coding skills',
    lines: [
      'HTML · CSS · JavaScript · PHP',
      'Astro · Git · Vite · GSAP · ML5',
      'React · React Native · TypeScript',
      'Three.js · WebGPU',
    ],
  },
];
---

<section class="about" id="about" aria-labelledby="about-title" data-section="about">
  <!-- The blue wave runs edge to edge, behind everything else -->
  <svg
    class="about__wave"
    data-layer="wave"
    viewBox={`${WAVE_BOX.x} ${WAVE_BOX.y} ${WAVE_BOX.w} ${WAVE_BOX.h}`}
    style={`--wx:${WAVE_BOX.x};--wy:${WAVE_BOX.y};--ww:${WAVE_BOX.w};--wh:${WAVE_BOX.h}`}
    aria-hidden="true"
  >
    <path class="about__wave-line" data-layer="wave-line" d={wavePath} />
    <path id="about-wave-text-path" d={textPath} fill="none" />
    <text class="about__wave-text" data-layer="wave-text" xml:space="preserve">
      <textPath href="#about-wave-text-path" data-layer="wave-text-path" startOffset={textStartOffset.toFixed(1)}>{WAVE_TEXT}</textPath>
    </text>
  </svg>

  <div class="about__frame">
    <!-- Title with the yellow highlighter bars behind each line -->
    <span class="about__marker about__marker--first" data-layer="title-marker" data-intro></span>
    <span class="about__marker about__marker--second" data-layer="title-marker" data-intro></span>
    <h2 class="about__title" id="about-title" data-layer="about-title">Good looks and good experiences</h2>

    <span class="about__star" data-layer="about-sparkle-big" data-intro style={layer(642.2, 794.8, 56.35)}><StarPinkLg /></span>
    <span class="about__star" data-layer="about-sparkle-big-outline" data-intro style={layer(644, 793.2, 56.35)}><StarOutlineLg /></span>
    <span class="about__star" data-layer="about-sparkle-small" data-intro style={layer(662.4, 774, 22.62)}><StarPinkSm /></span>
    <span class="about__star" data-layer="about-sparkle-small-outline" data-intro style={layer(663.1, 773.3, 22.62)}><StarOutlineSm /></span>

    <span class="about__star" data-layer="about-star-low" data-intro style={layer(1229.6, 927.3, 21.27)}><StarPinkSm /></span>
    <span class="about__star" data-layer="about-star-low-outline" data-intro style={layer(1230.3, 926.6, 21.27)}><StarOutlineSm /></span>
    <span class="about__star" data-layer="about-star-high" data-intro style={layer(1289.7, 760.7, 17.4)}><StarPinkSm /></span>
    <span class="about__star" data-layer="about-star-high-outline" data-intro style={layer(1290.3, 760.7, 17.4)}><StarOutlineSm /></span>

    <!-- Text card with corner brackets and the About me button -->
    <div class="about__card" data-layer="about-card" data-intro>
      <p class="about__text" data-layer="about-text" data-intro>
        <strong>I love the visual side of design</strong>: the colours, the details, and the little things that
        make you stop scrolling. But I care just as much about what happens next:
        <strong> how an experience works, feels, and makes sense to the people</strong> using it. And when an idea
        needs a little code to come to life, I’m happy to get my hands dirty.
      </p>
      <Button href={`${base}/about/`} text="About me" w={177} name="about-button" class="about__button" />
      <span class="about__corner about__corner--tl" data-layer="about-corner" data-intro></span>
      <span class="about__corner about__corner--tr" data-layer="about-corner" data-intro></span>
      <span class="about__corner about__corner--bl" data-layer="about-corner" data-intro></span>
      <span class="about__corner about__corner--br" data-layer="about-corner" data-intro></span>
    </div>

    <!--
      The skills paper comes out of the typewriter. Its bottom is tucked into the machine.
      The window hides whatever part of the paper is still inside the typewriter while it feeds up.
    -->
    <div class="about__paper-window">
    <div class="about__paper" data-layer="skills-paper">
      <div class="about__sheet" data-layer="skills-sheet" data-intro>
        {
          SKILLS.map(({ heading, lines }) => (
            <div class="about__skills" data-layer="skills-group">
              <h3 class="about__skills-heading" data-layer="skills-heading">
                <span class="about__skills-mark" data-layer="skills-mark"><span class="about__skills-name">{heading}</span>:</span>
              </h3>
              {lines.map((line) => (
                <p class="about__skills-line" data-layer="skills-line">
                  {line}
                </p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    </div>

    <div class="about__typewriter" data-layer="typewriter" data-intro>
      <Image
        class="about__typewriter-image"
        data-layer="typewriter-image"
        src={typewriter}
        alt="A pink typewriter typing out Irina’s skills"
        widths={[466, 932]}
        sizes="466px"
      />
    </div>
  </div>
</section>

<style>
  /*
    Desktop: the 1440 Figma frame sits in the middle column. The outer 1fr columns
    are 0 up to 1440px and centre the frame above it. Only the wave runs edge to edge.
  */
  .about {
    position: relative;
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    grid-template-rows: [content-start] calc(980 * var(--u)) [content-end];
    /* the wave is wider than the screen: clip it sideways only */
    overflow-x: clip;
  }

  .about__frame {
    grid-column: frame;
    grid-row: content;
    position: relative;
  }

  /* ---------- Wave ---------- */
  .about__wave {
    grid-column: full;
    grid-row: content;
    position: absolute;
    /* the frame's left edge is 720u left of the centre, the SVG starts further left */
    left: calc(50% + (var(--wx) - 720) * var(--u));
    top: calc(var(--wy) * var(--u));
    width: calc(var(--ww) * var(--u));
    height: calc(var(--wh) * var(--u));
    overflow: visible;
    z-index: 1;
    pointer-events: none;
  }

  .about__wave-line {
    fill: none;
    stroke: var(--c-blue);
    stroke-width: 60;
  }

  .about__wave-text {
    fill: var(--c-blue);
    font-family: var(--f-inter);
    font-size: 24px;
    white-space: pre;
  }

  /* ---------- Positioned collage pieces (Figma px from the frame's top-left) ---------- */
  .about__star {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    translate: -50% -50%;
    rotate: var(--r);
    z-index: 3;
  }

  .about__star :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Title ---------- */
  .about__title {
    position: absolute;
    left: calc(166 * var(--u));
    top: calc(50 * var(--u));
    width: calc(487 * var(--u));
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(42 * var(--u));
    line-height: 1.4;
    color: var(--c-ink);
    z-index: 2;
  }

  .about__marker {
    position: absolute;
    left: calc(150 * var(--u));
    height: calc(23 * var(--u));
    background: var(--c-marker);
    z-index: 1;
  }

  .about__marker--first {
    top: calc((818 - 11.5 - 720) * var(--u));
    width: calc(440 * var(--u));
  }

  .about__marker--second {
    top: calc((877 - 11.5 - 720) * var(--u));
    width: calc(508 * var(--u));
  }

  /* ---------- Text card ---------- */
  .about__card {
    position: absolute;
    left: calc(152 * var(--u));
    top: calc((921 - 720) * var(--u));
    width: calc(553 * var(--u));
    height: calc(310 * var(--u));
    padding: calc(37 * var(--u)) calc(40 * var(--u)) 0 calc(42 * var(--u));
    background: var(--c-light);
    z-index: 2;
  }

  .about__text {
    margin: 0;
    font-family: var(--f-sans);
    font-size: calc(20 * var(--u));
    line-height: 1.2;
    color: var(--c-ink);
  }

  .about__text strong {
    font-weight: 500;
  }

  .about__card :global(.about__button) {
    position: absolute;
    left: calc((194 - 152) * var(--u));
    top: calc((1117 - 921) * var(--u));
  }

  .about__corner {
    position: absolute;
    width: calc(12 * var(--u));
    height: calc(14 * var(--u));
    border: 0 solid var(--c-ink);
    --stroke: max(1.5px, calc(2.5 * var(--u)));
  }

  .about__corner--tl {
    top: 0;
    left: 0;
    border-top-width: var(--stroke);
    border-left-width: var(--stroke);
  }

  .about__corner--tr {
    top: 0;
    right: 0;
    border-top-width: var(--stroke);
    border-right-width: var(--stroke);
  }

  .about__corner--bl {
    bottom: 0;
    left: 0;
    border-bottom-width: var(--stroke);
    border-left-width: var(--stroke);
  }

  .about__corner--br {
    bottom: 0;
    right: 0;
    border-bottom-width: var(--stroke);
    border-right-width: var(--stroke);
  }

  /* ---------- Skills paper ---------- */
  /*
    The paper keeps its Figma left edge (x 688), its Figma width (287px) and its
    bottom inside the typewriter (y 1185). It grows upwards to fit the full list.
  */
  /*
    A window around the paper with its bottom edge at the roller (y 1185). Whatever is
    below it is "inside the typewriter", so the paper can start low and feed up.
    It's wider than the paper so the shadow and the tilt are never cut.
  */
  .about__paper-window {
    position: absolute;
    left: calc((688 - 40) * var(--u));
    bottom: calc((720 + 980 - 1185) * var(--u));
    width: calc((287 + 80) * var(--u));
    height: calc(700 * var(--u));
    overflow: hidden;
    z-index: 5;
    pointer-events: none;
  }

  .about__paper {
    position: absolute;
    left: calc(40 * var(--u));
    bottom: 0;
  }

  .about__sheet {
    width: calc(287 * var(--u));
    padding: calc(35 * var(--u)) calc(17 * var(--u)) calc(35 * var(--u)) calc(23 * var(--u));
    background: var(--c-light);
    box-shadow: calc(-5 * var(--u)) calc(-2 * var(--u)) calc(6 * var(--u)) oklch(26.16% 0.0296 267.48 / 0.1);
    rotate: -1.37deg;
    transform-origin: bottom center;
    font-family: var(--f-type);
    font-size: calc(16 * var(--u));
    color: var(--c-ink);
  }

  .about__skills + .about__skills {
    margin-top: calc(17.9 * var(--u));
  }

  .about__skills-heading {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    line-height: calc(20.8 * var(--u));
  }

  /*
    The grey highlight behind each heading (18px tall, a little wider than the text).
    --mark-w lets the script wipe it in from the left before the heading is typed.
  */
  .about__skills-mark {
    display: inline-block;
    margin-left: calc(-4 * var(--u));
    padding: 0 calc(5.5 * var(--u)) 0 calc(4 * var(--u));
    background: linear-gradient(var(--c-grey), var(--c-grey)) left center / var(--mark-w, 100%) calc(18 * var(--u))
      no-repeat;
  }

  /*
    The typed letters stay inline (SplitText makes them inline-block), so the
    underline under each heading's name keeps running under them.
  */
  .about__sheet :global(.about__char) {
    display: inline !important;
  }

  /* the heading's name is underlined, the colon isn't */
  .about__skills-name {
    text-decoration: underline;
    text-decoration-skip-ink: none;
  }

  /*
    With motion the name is typed letter by letter, so each letter carries its own piece of the
    underline. Otherwise the whole underline would show before the letters are typed.
  */
  :global(html[data-motion]) .about__skills-name {
    text-decoration: none;
  }

  :global(html[data-motion]) .about__skills-name :global(.about__char) {
    text-decoration: underline;
    text-decoration-skip-ink: none;
  }

  /* the first line sits 30px under its heading, as in Figma */
  .about__skills-heading + .about__skills-line {
    margin-top: calc(9.2 * var(--u));
  }

  .about__skills-line {
    margin: 0;
    line-height: calc(20.8 * var(--u));
  }

  /* ---------- Typewriter ---------- */
  .about__typewriter {
    position: absolute;
    left: calc((553 + 9) * var(--u));
    top: calc((1152 + 7 - 720) * var(--u));
    width: calc(466 * var(--u));
    z-index: 6;
  }

  .about__typewriter-image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(calc(-5 * var(--u)) calc(5 * var(--u)) calc(5.5 * var(--u)) oklch(26.16% 0.0296 267.48 / 0.1));
  }
</style>

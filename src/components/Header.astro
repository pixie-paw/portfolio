---
import Logo from '../assets/home/svg/logo-flower.svg';
import BackArrow from '../assets/projects/svg/back-arrow.svg';
import NavUnderline from '../assets/home/svg/nav-underline.svg';
import Button from './Button.astro';

/**
 * active = the page you're on ('about' on the About me page). Its link shows the
 * hover look for good: dark text and the blue underline.
 *
 * On a project page: back = where the back arrow goes (it takes the flower's place), and
 * links = the page's own links (Briefing, Process, Result), which scroll to its sections.
 */
interface Props {
  active?: 'projects' | 'about';
  back?: string;
  links?: { label: string; href: string }[];
}

const { active, back, links } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const NAV = links ?? [
  { label: 'Projects', href: `${base}/#work`, name: 'projects' as const },
  { label: 'About me', href: `${base}/about/`, name: 'about' as const },
];
const isActive = (link: (typeof NAV)[number]) => 'name' in link && link.name === active;
---

<!--
  Nav links: grey by default, dark with the blue underline on hover and when active.
  The active link gets site-header__link--active and aria-current. On the homepage
  none is active. On the About me page, About me is.
-->
<header class:list={['site-header', back && 'site-header--project']} data-layer="header">
  {
    back ? (
      <a class="site-header__back" href={back} aria-label="Back to my work" data-layer="back" data-intro>
        <BackArrow class="site-header__back-arrow" aria-hidden="true" data-layer="back-arrow" />
      </a>
    ) : (
      <a class="site-header__logo" href={`${base}/`} aria-label="Irina Moldovan, home" data-layer="logo" data-intro>
        <Logo class="site-header__flower" aria-hidden="true" data-layer="logo-flower" />
      </a>
    )
  }

  <nav class="site-header__nav" aria-label={back ? 'This project' : 'Main'}>
    {
      NAV.map((link) => (
        <a
          class:list={['site-header__link', isActive(link) && 'site-header__link--active']}
          href={link.href}
          aria-current={isActive(link) ? 'page' : undefined}
          data-layer={`nav-${'name' in link ? link.name : link.label.toLowerCase()}`}
          data-nav-link
          data-intro
        >
          <span class="site-header__label" data-layer="nav-label">{link.label}</span>
          <NavUnderline class="site-header__underline" aria-hidden="true" data-layer="nav-underline" />
        </a>
      ))
    }
  </nav>

  <!-- Opens a new email to Irina, from every page -->
  <Button href="mailto:irinammoldovan@gmail.com" text="Get in touch" w={216} name="cta" intro class="site-header__cta" />
</header>

<style>
  /*
    Desktop: one grid row, placed by named areas.
    Figma: logo at x45, nav at x841, button at x1124 (1440 frame).
  */
  .site-header {
    grid-area: header;
    display: grid;
    grid-template-columns:
      calc(45 * var(--u)) calc(149 * var(--u)) 1fr auto calc(50 * var(--u)) calc(216 * var(--u))
      calc(100 * var(--u));
    grid-template-areas: '. logo . nav . cta .';
    align-items: start;
    padding-top: calc(15 * var(--u));
    position: relative;
    z-index: 10;
  }

  .site-header__logo {
    grid-area: logo;
    width: calc(149 * var(--u));
  }

  .site-header__logo {
    display: block;
  }

  /* Project pages: the back arrow sits where the flower is, at x 50, y 56 in Figma */
  .site-header__back {
    grid-area: logo;
    display: block;
    width: calc(83.5 * var(--u));
    margin-left: calc(5 * var(--u));
    margin-top: calc(41 * var(--u));
  }

  .site-header__back-arrow {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__flower {
    display: block;
    width: 100%;
    height: auto;
    /* the centre of the flower's heart, so it spins in place */
    transform-origin: 48.5% 50%;
  }

  .site-header__nav {
    grid-area: nav;
    display: flex;
    gap: calc(53 * var(--u));
    margin-top: calc(47 * var(--u));
  }

  /* Project pages: Briefing, Process and Result are 56px apart and end 61px before the button */
  .site-header--project .site-header__nav {
    gap: calc(56 * var(--u));
    margin-right: calc(11 * var(--u));
  }

  .site-header__link {
    position: relative;
    font-size: calc(24 * var(--u));
    color: var(--c-ink);
    line-height: 1.2;
  }

  /*
    Ink at 68.4% opacity on the paper gives exactly --c-ink-soft (#727070).
    Fading the opacity to 1 on hover changes the colour without animating `color`.
  */
  .site-header__label {
    opacity: 0.684;
  }

  .site-header__link--active .site-header__label {
    opacity: 1;
  }

  /* 9px wider than the text on each side, as in Figma. Hidden until hover or active. */
  .site-header__underline {
    position: absolute;
    left: calc(-9 * var(--u));
    top: calc(32 * var(--u));
    width: calc(100% + 18 * var(--u));
    height: auto;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .site-header__link--active .site-header__underline {
    transform: none;
  }

  /*
    The button is its own component, which doesn't get this file's style scope,
    so it's reached with :global from inside the header.
  */
  .site-header :global(.site-header__cta) {
    grid-area: cta;
    margin-top: calc(33 * var(--u));
  }

  /* Mobile suggestion: small logo left, button right, nav links under them. */
  @media (max-width: 899px) {
    .site-header {
      grid-template-columns: var(--gutter) auto 1fr auto var(--gutter);
      grid-template-areas:
        '. logo . cta .'
        '. nav nav nav .';
      row-gap: 12px;
      padding-top: 12px;
    }

    .site-header__logo {
      width: 64px;
    }

    .site-header__nav {
      margin-top: 0;
      gap: 24px;
    }

    .site-header__link {
      font-size: 18px;
    }

    .site-header__underline {
      left: -6px;
      top: 24px;
      width: 76px;
    }

    .site-header :global(.site-header__cta) {
      margin-top: 12px;
    }
  }
</style>

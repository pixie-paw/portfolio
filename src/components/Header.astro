---
import Logo from '../assets/home/svg/logo-flower.svg';
import BackArrow from '../assets/projects/svg/back-arrow.svg';
import NavUnderline from '../assets/home/svg/nav-underline.svg';
import MenuClose from '../assets/home/svg/menu-close.svg';
import Button from './Button.astro';

/**
 * active = the page you're on ('about' on the About me page). Its link shows the
 * hover look for good: dark text and the blue underline.
 *
 * On a project page: back = where the back arrow goes (it takes the flower's place), and
 * links = the page's own links (Briefing, Process, Result), which scroll to its sections.
 * backLabel = what the back arrow says to screen readers.
 *
 * On the CV page: download = a file to download. It shows a dark DOWNLOAD CV button in place of
 * the nav links, 17px before Get in touch.
 */
interface Props {
  active?: 'projects' | 'about';
  back?: string;
  backLabel?: string;
  links?: { label: string; href: string }[];
  download?: string;
}

const { active, back, backLabel = 'Back to my work', links, download } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const NAV = links ?? [
  { label: 'Projects', href: `${base}/#work`, name: 'projects' as const },
  { label: 'About me', href: `${base}/about/`, name: 'about' as const },
];
const isActive = (link: (typeof NAV)[number]) => 'name' in link && link.name === active;

/*
  The phone menu always has the two main pages. A link only gets the Medium weight and the
  blue line when it's tapped (the script does that).
*/
const MENU = [
  { label: 'Projects', href: `${base}/#work`, name: 'projects' },
  { label: 'About me', href: `${base}/about/`, name: 'about' },
];
---

<!--
  Nav links: grey by default, dark with the blue underline on hover and when active.
  The active link gets site-header__link--active and aria-current. On the homepage
  none is active. On the About me page, About me is.
-->
<header class:list={['site-header', back && 'site-header--project', download && 'site-header--download']} data-layer="header">
  {
    back ? (
      <a class="site-header__back" href={back} aria-label={backLabel} data-layer="back" data-intro>
        <BackArrow class="site-header__back-arrow" aria-hidden="true" data-layer="back-arrow" />
      </a>
    ) : (
      <a class="site-header__logo" href={`${base}/`} aria-label="Irina Moldovan, home" data-layer="logo" data-intro>
        <Logo class="site-header__flower" aria-hidden="true" data-layer="logo-flower" />
      </a>
    )
  }

  {
    download ? (
      <Button href={download} text="Download CV" w={216} name="header-download" tone="dark" download intro class="site-header__download" />
    ) : (
  <nav class="site-header__nav" aria-label={back ? 'This project' : 'Main'}>
    {
      NAV.map((link) => (
        <a
          class:list={['site-header__link', isActive(link) && 'site-header__link--active']}
          href={link.href}
          aria-current={isActive(link) ? 'page' : undefined}
          data-layer={`nav-${'name' in link ? link.name : link.label.toLowerCase()}`}
          data-nav-link
          data-intro
        >
          <span class="site-header__label" data-layer="nav-label" data-text={link.label}>{link.label}</span>
          <NavUnderline class="site-header__underline" aria-hidden="true" data-layer="nav-underline" />
        </a>
      ))
    }
  </nav>
    )
  }

  <!-- Opens a new email to Irina, from every page -->
  <Button href="mailto:irinammoldovan@gmail.com" text="Get in touch" w={216} name="cta" intro class="site-header__cta" />

  <!-- Phones only: opens the menu below. The copy of the header that comes back on scroll has one too. -->
  <button
    class="site-header__menu"
    type="button"
    aria-label="Open the menu"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-open
    data-layer="menu-open"
  >
    <span class="site-header__menu-line"></span>
    <span class="site-header__menu-line"></span>
    <span class="site-header__menu-line"></span>
  </button>
</header>

<!--
  Phone menu (Figma 523:1336): a light pink screen with the two pages and Get in touch.
  A modal <dialog>, so the page under it can't be reached with the keyboard while it's open,
  and Escape closes it. The script slides it in and out.
-->
<dialog class="site-menu" id="site-menu" aria-label="Menu" data-menu>
  <!-- The pink sheet slides in and out as one, with the close button and the dividers on it -->
  <div class="site-menu__sheet" data-layer="menu-sheet">
    <div class="site-menu__frame">
      <button class="site-menu__close" type="button" aria-label="Close the menu" data-menu-close data-layer="menu-close">
        <MenuClose class="site-menu__close-icon" aria-hidden="true" />
      </button>

      <nav class="site-menu__nav" aria-label="Main">
        <ul class="site-menu__list">
          {
            MENU.map((link) => (
              <li class="site-menu__item">
                <a
                  class="site-menu__link"
                  href={link.href}
                  aria-current={link.name === active ? 'page' : undefined}
                  data-menu-link
                  data-layer={`menu-${link.name}`}
                >
                  <span class="site-menu__label" data-text={link.label}>{link.label}</span>
                  <span class="site-menu__underline" aria-hidden="true" data-layer="menu-underline"></span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <Button href="mailto:irinammoldovan@gmail.com" text="Get in touch" w={216} name="menu-cta" class="site-menu__cta" />
    </div>
  </div>
</dialog>

<style>
  /*
    Desktop: one grid row, placed by named areas.
    Figma: logo at x45, nav at x841, button at x1124 (1440 frame).
  */
  .site-header {
    grid-area: header;
    display: grid;
    grid-template-columns:
      calc(45 * var(--u)) calc(149 * var(--u)) 1fr auto calc(50 * var(--u)) calc(216 * var(--u))
      calc(100 * var(--u));
    grid-template-areas: '. logo . nav . cta .';
    align-items: start;
    padding-top: calc(15 * var(--u));
    position: relative;
    z-index: 10;
  }

  /* The CV page: DOWNLOAD CV sits 17px before Get in touch, as in Figma */
  .site-header--download {
    grid-template-columns:
      calc(45 * var(--u)) calc(149 * var(--u)) 1fr auto calc(17 * var(--u)) calc(216 * var(--u))
      calc(100 * var(--u));
  }

  .site-header :global(.site-header__download) {
    grid-area: nav;
    margin-top: calc(33 * var(--u));
  }

  .site-header__logo {
    grid-area: logo;
    width: calc(149 * var(--u));
  }

  .site-header__logo {
    display: block;
  }

  /* Project pages: the back arrow sits where the flower is, at x 50, y 56 in Figma */
  .site-header__back {
    grid-area: logo;
    display: block;
    width: calc(83.5 * var(--u));
    margin-left: calc(5 * var(--u));
    margin-top: calc(41 * var(--u));
  }

  .site-header__back-arrow {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__flower {
    display: block;
    width: 100%;
    height: auto;
    /* the centre of the flower's heart, so it spins in place */
    transform-origin: 48.5% 50%;
  }

  .site-header__nav {
    grid-area: nav;
    display: flex;
    gap: calc(53 * var(--u));
    margin-top: calc(47 * var(--u));
  }

  /* Project pages: Briefing, Process and Result are 56px apart and end 61px before the button */
  .site-header--project .site-header__nav {
    gap: calc(56 * var(--u));
    margin-right: calc(11 * var(--u));
  }

  .site-header__link {
    position: relative;
    font-size: max(var(--fs-min), calc(24 * var(--u)));
    color: var(--c-ink);
    line-height: 1.2;
  }

  /*
    Ink at 68.4% opacity on the paper gives exactly --c-ink-soft (#727070).
    Fading the opacity to 1 on hover changes the colour without animating `color`.
  */
  .site-header__label {
    opacity: 0.684;
  }

  .site-header__link--active .site-header__label {
    opacity: 1;
  }

  /*
    On hover, keyboard focus and for the active link, the label turns Medium (500) as well.
    A hidden Medium copy of the label (::after) keeps the link as wide as its Medium text, so the
    links beside it never shift when it changes.
  */
  .site-header__label {
    display: inline-grid;
  }

  .site-header__label::after {
    content: attr(data-text);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 500;
  }

  .site-header__link:hover .site-header__label,
  .site-header__link:focus-visible .site-header__label,
  .site-header__link--active .site-header__label {
    font-weight: 500;
  }

  /* 9px wider than the text on each side, as in Figma. Hidden until hover or active. */
  .site-header__underline {
    position: absolute;
    left: calc(-9 * var(--u));
    top: calc(32 * var(--u));
    width: calc(100% + 18 * var(--u));
    height: auto;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .site-header__link--active .site-header__underline {
    transform: none;
  }

  /*
    The button is its own component, which doesn't get this file's style scope,
    so it's reached with :global from inside the header.
  */
  .site-header :global(.site-header__cta) {
    grid-area: cta;
    margin-top: calc(33 * var(--u));
  }

  /* ---------- Menu button: phones only ---------- */
  /* Figma: 47 x 40, green with a 2px ink border, three 24px lines */
  .site-header__menu {
    grid-area: menu;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(5.5 * var(--m));
    width: calc(47 * var(--m));
    height: calc(40 * var(--m));
    padding: 0;
    background: var(--c-green);
    border: 2px solid var(--c-ink);
    cursor: pointer;
  }

  .site-header__menu-line {
    display: block;
    width: calc(24 * var(--m));
    height: 2px;
    background: var(--c-ink);
  }

  /*
    ---------- Phone (< 768px), Figma 518:676 (393px frame) ----------
    The flower on the left and the menu button on the right. The nav links and Get in touch
    move into the menu.
  */
  @media (max-width: 767px) {
    .site-header {
      grid-template-columns: auto 1fr calc(47 * var(--m)) calc(8 * var(--m));
      grid-template-areas: 'logo . menu .';
      padding-top: 0;
    }

    /* Figma: 92.93px wide, at x -4, y 13 */
    .site-header__logo {
      width: calc(92.93 * var(--m));
      margin: calc(13 * var(--m)) 0 0 calc(-4 * var(--m));
    }

    /* Project pages (Figma 529:2153): the back arrow, 54px wide at x 9, y 37 */
    .site-header__back {
      width: calc(54 * var(--m));
      margin: calc(37 * var(--m)) 0 0 calc(9 * var(--m));
    }

    .site-header__nav,
    .site-header :global(.site-header__cta),
    .site-header :global(.site-header__download) {
      display: none;
    }

    /* Figma: x 338, y 37 */
    .site-header__menu {
      display: flex;
      margin-top: calc(37 * var(--m));
    }

    /*
      Project pages (Figma 529:2153): the back arrow on the left and Get in touch on the right,
      no menu. The button is the desktop one at 0.7824 of its size (169 x 40.7), at x 216, y 34.
    */
    .site-header--project {
      grid-template-columns: auto 1fr auto calc(8 * var(--m));
      grid-template-areas: 'logo . cta .';
    }

    .site-header--project .site-header__menu {
      display: none;
    }

    .site-header--project :global(.site-header__cta) {
      --u: calc(0.7824 * var(--m));
      display: inline-flex;
      margin-top: calc(34 * var(--m));
      font-size: calc(16 * var(--u));
      border-width: calc(2 * var(--u));
    }
  }

  /* ---------- Phone menu ---------- */
  .site-menu {
    /* the buttons inside are sized in Figma pixels of the phone frame */
    --u: var(--m);
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-ink);
    /*
      clip, not hidden: a hidden box can still be scrolled by the browser, and opening the dialog
      focuses the close button while the sheet is still off to the right, which scrolled the sheet
      sideways so it stopped short of its place
    */
    overflow: clip;
  }

  .site-menu::backdrop {
    background: transparent;
  }

  /* Figma: #fcf4f6, the whole screen. It scrolls on its own if a phone is too short for it. */
  .site-menu__sheet {
    position: absolute;
    inset: 0;
    overflow: hidden auto;
    background: var(--c-tag);
  }

  /*
    The 393px frame sits in the middle, the dividers run edge to edge.
    Figma: close at y 36, Projects at y 259, dividers at y 321 and 432, Get in touch at y 479.
  */
  .site-menu__frame {
    position: relative;
    display: grid;
    grid-template-columns: 1fr calc(393 * var(--m)) 1fr;
    grid-template-areas:
      '.   close .'
      'nav nav   nav'
      '.   cta   .';
    padding-bottom: calc(48 * var(--m));
  }

  /* Figma: 47 x 40 at x 9, y 36, the same green as the menu button */
  .site-menu__close {
    grid-area: close;
    justify-self: start;
    display: grid;
    place-items: center;
    width: calc(47 * var(--m));
    height: calc(40 * var(--m));
    margin: calc(36 * var(--m)) 0 0 calc(9 * var(--m));
    padding: 0;
    background: var(--c-green);
    border: 2px solid var(--c-ink);
    cursor: pointer;
  }

  .site-menu__close-icon {
    display: block;
    width: calc(20.85 * var(--m));
    height: auto;
  }

  .site-menu__nav {
    grid-area: nav;
    margin-top: calc((259 - 76) * var(--m));
  }

  .site-menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  /* The dividers: 1.5px ink lines across the whole screen */
  .site-menu__item {
    border-bottom: calc(1.5 * var(--m)) solid var(--c-ink);
  }

  .site-menu__item:first-child {
    padding-bottom: calc(32.25 * var(--m));
  }

  .site-menu__item + .site-menu__item {
    padding: calc(41.25 * var(--m)) 0 calc(39.25 * var(--m));
  }

  /*
    Figma: Akzidenz 24px, --c-ink-soft. Tapped, it turns Medium and ink, and the blue line grows
    under it, like the desktop nav links on hover.
  */
  .site-menu__link {
    position: relative;
    display: inline-block;
    font-family: var(--f-sans);
    font-size: calc(24 * var(--m));
    line-height: calc(29 / 24);
    color: var(--c-ink-soft);
    -webkit-tap-highlight-color: transparent;
  }

  /* A hidden Medium copy (::after) keeps the label as wide as its Medium text, so it never shifts */
  .site-menu__label {
    display: inline-grid;
  }

  .site-menu__label::after {
    content: attr(data-text);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 500;
  }

  .site-menu__link--tapped {
    font-weight: 500;
    color: var(--c-ink);
  }

  /* Figma: 2.5px blue, 7px wider than the text on each side. Hidden until tapped. */
  .site-menu__underline {
    position: absolute;
    left: calc(-7 * var(--m));
    right: calc(-7 * var(--m));
    top: calc(30.75 * var(--m));
    height: calc(2.5 * var(--m));
    background: var(--c-blue);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .site-menu__link--tapped .site-menu__underline {
    transform: none;
  }

  /* Figma: 216 x 52, centred, 46px under the last divider */
  .site-menu :global(.site-menu__cta) {
    grid-area: cta;
    justify-self: center;
    margin-top: calc(46.25 * var(--m));
  }
</style>

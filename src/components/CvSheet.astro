---
import { Image } from 'astro:assets';
import Header from './Header.astro';
import Tag from './Tag.astro';
import { CV_FILE } from '../data/cv';

import irina from '../assets/cv/irina.webp';
import Wave from '../assets/cv/wave.svg';
import Divider from '../assets/cv/divider.svg';
import PhotoFill from '../assets/cv/photo-fill.svg';
import PhotoOutlineA from '../assets/cv/photo-outline-a.svg';
import PhotoOutlineB from '../assets/cv/photo-outline-b.svg';
import Flower from '../assets/cv/flower.svg';
import StarLg from '../assets/cv/star-lg.svg';
import StarSm from '../assets/cv/star-sm.svg';
import IntroCard from '../assets/cv/intro-card.svg';
import Globe from '../assets/cv/globe.svg';
import Mail from '../assets/cv/mail.svg';
import LinkedIn from '../assets/cv/linkedin.svg';
import Behance from '../assets/cv/behance.svg';

/*
  The CV page: the header (back to About me, DOWNLOAD CV, Get in touch) and Irina's CV as real
  text on a white sheet. Figma pixels from the 1440px "3.1 Check my CV" frame. The sheet sits at
  x 205, y 209 and everything on it is placed from the sheet's top-left corner, so it keeps the
  exact layout of the PDF. Irina's copy, word for word.

  The texture: the page's own texture layer (in global.css) lies over everything. The sheet sits
  above it, so the CV's text stays clear, and carries its own texture on its top part only
  (the name, photo and intro), as in Figma.
*/
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// x / y = top-left corner on the sheet, w / h = size, r = tilt in degrees
const place = (x: number, y: number, w: number, h = 0, r = 0) => `--x:${x};--y:${y};--w:${w};--h:${h};--r:${r}deg`;

const EXPERIENCE = [
  {
    title: 'Graphic Designer Intern',
    place: 'Value Network · Belgium',
    dates: 'Jan 2024 – Apr 2024',
    text: 'Designed social media content for employer branding and partner promotion.',
    y: 610.58,
  },
  {
    title: 'Analyst',
    place: 'Evalueserve · Romania',
    dates: 'Apr 2022 – Jul 2023',
    text: 'Conducted enhanced due diligence research on companies and individuals across the EMEA region.',
    y: 736.85,
  },
  {
    title: 'Freelance Graphic Designer',
    place: 'Self-employed · Romania',
    dates: 'Jul 2018 – Dec 2022',
    text: 'Branding and visual design for clients on request.',
    y: 863.11,
  },
  {
    title: 'Research Analyst',
    place: 'Yardi Matrix · Romania',
    dates: 'Jan 2017 – Sep 2018',
    text: 'Researched real estate markets, collected and analysed property data, and maintained company databases.',
    y: 965.17,
  },
];

const SKILLS = [
  {
    tag: 'Visual Design',
    text: 'Visual identity · Typography · Layout · Motion design · Photo editing · 3D modelling',
    y: 605.39,
  },
  {
    tag: 'UI/UX',
    text: 'User research · Concept development · User flows · Information architecture · Wireframing · Prototyping · Usability Testing',
    y: 714.36,
  },
  {
    tag: 'Development',
    text: 'HTML · CSS · JavaScript · TypeScript · Astro · React & React Native · GSAP · PHP · Git · Vite · Three.js · WebGPU',
    y: 844.09,
  },
];

// The other right-column lists: heading y, and its list's y
const LISTS = [
  { id: 'cv-soft-skills', title: 'Soft skills', y: 980.73, star: 989.4, text: 'Creative problem-solving · Communication · Critical thinking · Teamwork · Project coordination · Attention to detail · Adaptability', textY: 1025.71 },
  { id: 'cv-tools', title: 'Tools', y: 1121.96, star: 1130.65, text: 'Figma · Photoshop · Lightroom · Illustrator · After Effects · Blender', textY: 1166.93 },
  { id: 'cv-languages', title: 'Languages', y: 1243.04, star: 1251.75, text: 'Romanian · English', textY: 1288.01 },
];
---

<section class="cv" aria-labelledby="cv-name" data-section="cv">
  <div class="cv__frame">
    <div class="cv__header">
      <Header back={`${base}/about/`} backLabel="Back to About me" download={`${base}/${CV_FILE}`} />
    </div>

    <!-- The CV sheet -->
    <article class="cv__sheet" data-layer="cv-sheet">
      <!-- ---------- Top part, with the texture ---------- -->
      <span class="cv__layer cv__wave" style={place(-122.6, 169.72, 1188.4, 236.28, -7.35)} aria-hidden="true"><Wave /></span>
      <span class="cv__plate" aria-hidden="true"></span>
      <span class="cv__band" aria-hidden="true"></span>

      <span class="cv__layer cv__photo-fill" style={place(97.98, 19.03, 175.94, 498.69)} aria-hidden="true"><PhotoFill /></span>
      <span class="cv__layer cv__photo-outline" style={place(94.43, 16.59, 177.34, 507.02)} aria-hidden="true"><PhotoOutlineA /></span>
      <span class="cv__layer cv__photo-outline" style={place(99.99, 17.11, 177.34, 502.11)} aria-hidden="true"><PhotoOutlineB /></span>
      <Image class="cv__layer cv__photo" src={irina} alt="Irina in a long beige coat" widths={[164, 328]} sizes="164px" style={place(106.85, 20.05, 163.64, 495.89)} />

      <h1 class="cv__name" id="cv-name">IRINA MOLDOVAN</h1>
      <p class="cv__subtitle">&lt;I’m a Digital Designer &amp; Developer&gt;</p>
      <span class="cv__layer cv__star" style={place(257.72, 99.2, 37.99, 38.06)} aria-hidden="true"><StarLg /></span>
      <span class="cv__layer cv__star" style={place(762.79, 71.53, 37.99, 38.06)} aria-hidden="true"><StarLg /></span>
      <span class="cv__layer cv__flower" style={place(799.12, 28.28, 173.94, 173.94)} aria-hidden="true"><Flower /></span>

      <!-- The intro card (its corners are part of the drawing) -->
      <span class="cv__layer cv__intro-card" style={place(293.64, 226.15, 599.34, 245.36)} aria-hidden="true"><IntroCard /></span>
      <div class="cv__intro">
        <h2 class="cv__hello">Hello!</h2>
        <p class="cv__intro-text">
          I’m a Digital Design &amp; Development student at Devine, Howest, with a soft spot for visual design, UI/UX
          and the occasional coding challenge. I enjoy combining creativity with technology, from developing visual
          concepts and designing interfaces to bringing them to life through code.
        </p>
      </div>
      <Tag name="cv-internship" text="{ seeking internship · Feb 2027 - May 2027 }" x={720.79} y={459.92} w={405.5} h={50.48} size="lg" rotate={-3.15} paper="var(--c-green)" class="cv__internship" />

      <!-- The top part's own texture: only over the top, so the text below stays clear -->
      <span class="cv__texture" aria-hidden="true"></span>

      <!-- ---------- Left column: experience and education ---------- -->
      <span class="cv__layer cv__divider" style={place(636.53, 550.04, 3.46, 767.98)} aria-hidden="true"><Divider /></span>

      <span class="cv__layer cv__star" style={place(20.76, 559.83, 27.68, 27.73)} aria-hidden="true"><StarSm /></span>
      <h2 class="cv__heading" style="--x:51.89;--y:550.04">Experience</h2>
      {
        EXPERIENCE.map(({ title, place: where, dates, text, y }) => (
          <div class="cv__job" style={`--y:${y}`}>
            <h3 class="cv__job-title">{title}</h3>
            <p class="cv__job-place">{where}</p>
            <p class="cv__job-dates">{dates}</p>
            <p class="cv__job-text">{text}</p>
          </div>
        ))
      }

      <span class="cv__layer cv__star" style={place(20.76, 1132.36, 27.68, 27.73)} aria-hidden="true"><StarSm /></span>
      <h2 class="cv__heading" style="--x:51.89;--y:1122.57">Education</h2>
      <div class="cv__job" style="--y:1183.11">
        <h3 class="cv__job-title">Bachelor in Digital Design &amp; Development</h3>
        <p class="cv__job-place">Devine, Howest University of Applied Sciences · Kortrijk</p>
        <p class="cv__job-dates">2024 – Present</p>
      </div>

      <!-- ---------- Right column: skills, soft skills, tools and languages ---------- -->
      <span class="cv__layer cv__star" style={place(662.47, 558.7, 27.68, 27.73)} aria-hidden="true"><StarSm /></span>
      <h2 class="cv__heading" style="--x:693.61;--y:550.04">Skills</h2>
      {
        SKILLS.map(({ tag, text, y }) => (
          <>
            <Tag name="cv-skill" text={`{ ${tag} }`} x={662.47 + 85.62} y={y + 17.3} w={165} h={33.33} size="lg" class="cv__skill-tag" />
            <p class="cv__list" style={`--y:${y + 39.78}`}>{text}</p>
          </>
        ))
      }
      {
        LISTS.map(({ id, title, y, star, text, textY }) => (
          <>
            <span class="cv__layer cv__star" style={place(662.47, star, 27.68, 27.73)} aria-hidden="true"><StarSm /></span>
            <h2 class="cv__heading" id={id} style={`--x:693.61;--y:${y}`}>{title}</h2>
            <p class="cv__list" style={`--y:${textY}`}>{text}</p>
          </>
        ))
      }

      <!-- ---------- The pink band with the links ---------- -->
      <footer class="cv__contact">
        <a class="cv__link" href="https://www.irinamoldovan.be" style="--x:20.76;--y:1388.94">
          <Globe class="cv__icon cv__icon--globe" aria-hidden="true" />
          <span>irinamoldovan.be</span>
        </a>
        <a class="cv__link" href="mailto:irinammoldovan@gmail.com" style="--x:20.76;--y:1416.62">
          <Mail class="cv__icon cv__icon--mail" aria-hidden="true" />
          <span>irinammoldovan@gmail.com</span>
        </a>
        <a class="cv__link cv__link--end" href="https://www.linkedin.com/in/irina-maria-moldovan/" target="_blank" rel="noopener noreferrer" style="--y:1388.94">
          <span><span class="visually-hidden">LinkedIn: </span>/irina-maria-moldovan<span class="visually-hidden"> (opens in a new tab)</span></span>
          <LinkedIn class="cv__icon cv__icon--linkedin" aria-hidden="true" />
        </a>
        <a class="cv__link cv__link--end" href="https://www.behance.net/irinamoldovan2" target="_blank" rel="noopener noreferrer" style="--y:1416.62">
          <span><span class="visually-hidden">Behance: </span>/irinamoldovan2<span class="visually-hidden"> (opens in a new tab)</span></span>
          <Behance class="cv__icon cv__icon--behance" aria-hidden="true" />
        </a>
      </footer>
    </article>
  </div>
</section>

<style>
  /*
    Desktop: the 1440 Figma frame sits in the middle column. The outer 1fr columns
    are 0 up to 1440px and centre the frame above it. The section ends where the marquee
    starts (its words at Figma y 1919, 201px into it).
  */
  .cv {
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    grid-template-rows: [content-start] calc((1919 - 201) * var(--u)) [content-end];
  }

  .cv__frame {
    grid-column: frame;
    grid-row: content;
    position: relative;
  }

  .cv__header {
    position: relative;
    z-index: 10;
  }

  /*
    The sheet: x 205, y 209, 1029.17 x 1456.4, white. It's above the page's texture layer
    (z-index 100 in global.css), so the CV's text has no texture over it.
  */
  .cv__sheet {
    position: absolute;
    left: calc(205 * var(--u));
    top: calc(209 * var(--u));
    width: calc(1029.17 * var(--u));
    height: calc(1456.4 * var(--u));
    overflow: hidden;
    background: oklch(100% 0 0);
    color: var(--c-ink);
    z-index: 101;
  }

  /* The top part's texture, like the page's texture layer, over the top third of the sheet */
  .cv__texture {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(477 * var(--u));
    background-image: var(--texture-url);
    background-size: max(calc(488 * var(--u)), 320px) auto;
    mix-blend-mode: lighten;
    pointer-events: none;
    z-index: 6;
  }

  /* ---------- Layers placed from their top-left corner ---------- */
  .cv__layer {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    rotate: var(--r);
  }

  .cv__layer :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The wave is tilted around its centre, as in Figma */
  .cv__wave {
    transform-origin: 50% 50%;
  }

  /* Figma: 683.74 x 114.85 at x 199.82, y 40.29, tilted -3deg */
  .cv__plate {
    position: absolute;
    left: calc(199.82 * var(--u));
    top: calc(40.29 * var(--u));
    width: calc(683.74 * var(--u));
    height: calc(114.85 * var(--u));
    background: var(--c-ink);
    rotate: -3deg;
  }

  /* Figma: the band runs past both sides of the sheet, 91.67px tall at y 152.82 */
  .cv__band {
    position: absolute;
    left: calc(-17.3 * var(--u));
    top: calc(152.82 * var(--u));
    width: calc(1086.25 * var(--u));
    height: calc(91.67 * var(--u));
    background: var(--c-ink);
  }

  .cv__photo-fill,
  .cv__photo-outline {
    z-index: 1;
  }

  .cv__photo {
    z-index: 2;
    object-fit: cover;
    filter: drop-shadow(calc(-2.7 * var(--u)) calc(2.16 * var(--u)) calc(1.08 * var(--u)) oklch(26.16% 0.0296 267.48 / 0.1));
  }

  /* Figma: Boldonse 44.97px, light, centred at x 529.21, y 105.86, tilted -3deg */
  .cv__name {
    position: absolute;
    left: calc(529.21 * var(--u));
    top: calc(105.86 * var(--u));
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(44.97 * var(--u));
    line-height: normal;
    white-space: nowrap;
    color: var(--c-light);
    transform: translate(-50%, -50%) rotate(-3deg);
    z-index: 3;
  }

  /* Figma: Bona Nova 38.05px, light, at x 292.32, y 172.97 */
  .cv__subtitle {
    position: absolute;
    left: calc(292.32 * var(--u));
    top: calc(172.97 * var(--u));
    margin: 0;
    font-family: var(--f-serif);
    font-size: calc(38.05 * var(--u));
    line-height: normal;
    white-space: nowrap;
    color: var(--c-light);
    z-index: 3;
  }

  .cv__star {
    z-index: 3;
  }

  .cv__flower {
    z-index: 4;
  }

  .cv__intro-card {
    z-index: 3;
  }

  /* Figma: "Hello!" at x 316.53, y 246.22; the text at y 311.95, 553.5px wide */
  .cv__intro {
    position: absolute;
    left: calc(316.53 * var(--u));
    top: calc(246.22 * var(--u));
    width: calc(553.5 * var(--u));
    z-index: 4;
  }

  .cv__hello {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(27.68 * var(--u));
    line-height: normal;
    /* the text starts at y 311.95 */
    height: calc((311.95 - 246.22) * var(--u));
  }

  .cv__intro-text {
    margin: 0;
    font-family: var(--f-sans);
    font-size: calc(20.76 * var(--u));
    line-height: 1.2;
  }

  /* The internship tag: green, Bulletin 24.2px (the tags drawn 1.21 times bigger) */
  .cv__sheet :global(.cv__internship) {
    --k: calc(1.2108 * var(--u));
    z-index: 5;
  }

  /* The skill tags: Bulletin 20.76px, 171.24 x 34.59 */
  .cv__sheet :global(.cv__skill-tag) {
    --k: calc(1.0378 * var(--u));
  }

  /* ---------- Text below the top part ---------- */
  .cv__divider {
    z-index: 1;
  }

  /* Figma: Boldonse 24.22px */
  .cv__heading {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(24.22 * var(--u));
    line-height: normal;
    white-space: nowrap;
  }

  /* One job: its title, place and text on the left (x 20.76), its dates on the right (ending at x 617.5) */
  .cv__job {
    position: absolute;
    left: calc(20.76 * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc((617.5 - 20.76) * var(--u));
    font-family: var(--f-sans);
  }

  .cv__job-title {
    margin: 0;
    font-family: var(--f-sans);
    font-weight: 500;
    font-size: calc(20.76 * var(--u));
    line-height: 1.2;
  }

  .cv__job-place,
  .cv__job-dates {
    margin: 0;
    font-size: calc(17.3 * var(--u));
    line-height: 1.2;
    color: var(--c-ink-meta);
  }

  /* Figma: the dates' bottom line up with the title's, 3.46px lower */
  .cv__job-dates {
    position: absolute;
    right: 0;
    top: calc(3.46 * var(--u));
  }

  /* Figma: 26px under the title's top, 441px wide */
  .cv__job-text {
    margin: calc((660.74 - 634.8 - 20.76) * var(--u)) 0 0;
    width: calc(444.53 * var(--u));
    font-size: calc(20.76 * var(--u));
    line-height: 1.2;
  }

  /* Figma: 17.3px, 345.94px wide, at x 662.47 */
  .cv__list {
    position: absolute;
    left: calc(662.47 * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(345.94 * var(--u));
    margin: 0;
    font-family: var(--f-sans);
    font-size: calc(17.3 * var(--u));
    line-height: 1.2;
  }

  /* ---------- The pink band: 86.48px tall at the bottom ---------- */
  .cv__contact {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(86.48 * var(--u));
    background: var(--c-pink);
  }

  /* Figma: 17.3px, underlined; the top of each line is the bottom band's y */
  .cv__link {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc((var(--y) - 1369.91) * var(--u));
    display: flex;
    align-items: center;
    gap: calc(6.92 * var(--u));
    font-family: var(--f-sans);
    font-size: calc(17.3 * var(--u));
    line-height: 1.2;
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-position: from-font;
  }

  /* LinkedIn and Behance end at x 1008.41, with their icons after the text */
  .cv__link--end {
    left: auto;
    right: calc((1029.17 - 1008.41) * var(--u));
  }

  .cv__icon {
    display: block;
    flex: none;
  }

  .cv__icon--globe,
  .cv__icon--linkedin {
    width: calc(17.3 * var(--u));
    height: calc(17.3 * var(--u));
  }

  .cv__icon--mail {
    width: calc(17.87 * var(--u));
    height: calc(13.41 * var(--u));
  }

  .cv__icon--behance {
    width: calc(17.3 * var(--u));
    height: calc(11.42 * var(--u));
  }
</style>

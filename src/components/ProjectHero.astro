---
import { Image } from 'astro:assets';
import Header from './Header.astro';
import Tag from './Tag.astro';
import Button from './Button.astro';

/*
  The top of a project page: the header with the back arrow and the page's own links, the dark
  band with the project's name, its tags, one line about it, two buttons and the mockup.
  Figma pixels from the 1440px "2.0 Projects page_MemoMe" frame, measured from its top-left.
  Every project page uses this; each one passes its own content.
*/
interface Props {
  title: string;
  // Each tag's text, and its paper width at the home page's tag size (it's drawn 1.17 times bigger here)
  tags: { text: string; w: number }[];
  summary: string;
  resultUrl: string;
  mockup: ImageMetadata;
  mockupAlt: string;
}

const { title, tags, summary, resultUrl, mockup, mockupAlt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const LINKS = [
  { label: 'Briefing', href: '#briefing' },
  { label: 'Process', href: '#process' },
  { label: 'Result', href: '#result' },
];
---

<section class="project-hero" aria-labelledby="project-title" data-section="project-hero">
  <!-- The dark band runs edge to edge, like in Figma where it runs off the frame -->
  <div class="project-hero__band" data-layer="project-band" data-intro aria-hidden="true"></div>

  <div class="project-hero__frame">
    <div class="project-hero__header">
      <Header back={`${base}/#work`} links={LINKS} />
    </div>

    <Image
      class="project-hero__mockup"
      data-layer="project-mockup"
      data-intro
      src={mockup}
      alt={mockupAlt}
      widths={[908, 1816]}
      sizes="(max-width: 767px) min(123vw, 590px), calc(908 * min(100vw, 1440px) / 1440)"
      loading="eager"
      fetchpriority="high"
    />

    <h1 class="project-hero__title" id="project-title" data-layer="project-title" data-intro>{title}</h1>

    <div class="project-hero__tags" data-layer="project-tags" data-intro>
      {tags.map(({ text, w }) => <Tag name="project-tag" text={`{ ${text} }`} x={0} y={0} w={w} h={32} flow />)}
    </div>

    <!-- The summary and the buttons share a box, so on tablets the buttons can move down when the text grows -->
    <div class="project-hero__intro">
      <p class="project-hero__summary" data-layer="project-summary" data-intro>{summary}</p>

      <div class="project-hero__buttons" data-layer="project-buttons" data-intro>
        <Button href={resultUrl} text="See the result" w={209} name="project-see-result" newTab />
        <Button href="#process" text="Read the process" w={250} name="project-read-process" tone="dark" />
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Desktop: the 1440 Figma frame sits in the middle column. The outer 1fr columns
    are 0 up to 1440px and centre the frame above it. Only the band runs edge to edge.
  */
  .project-hero {
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    grid-template-rows: [content-start] calc(790 * var(--u)) [content-end];
    /* the mockup slides in from past the right edge: clip it sideways only */
    overflow-x: clip;
  }

  .project-hero__frame {
    grid-column: frame;
    grid-row: content;
    position: relative;
  }

  .project-hero__header {
    position: relative;
    z-index: 10;
  }

  /* Figma: y 322, 141px tall */
  .project-hero__band {
    grid-column: full;
    grid-row: content;
    align-self: start;
    margin-top: calc(322 * var(--u));
    height: calc(141 * var(--u));
    background: var(--c-ink);
  }

  /*
    Figma: x 631, y 223, 908px wide. The laptop runs past the right side of the 1440 frame, so
    it reaches the right edge of the screen at any width. Above the band.
  */
  .project-hero__mockup {
    position: absolute;
    left: calc(631 * var(--u));
    top: calc(223 * var(--u));
    width: calc(908 * var(--u));
    height: auto;
    z-index: 2;
  }

  /* Figma: x 63, y 353, Boldonse 50px (its text box is 96px tall) */
  .project-hero__title {
    position: absolute;
    left: calc(63 * var(--u));
    top: calc(353 * var(--u));
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(50 * var(--u));
    line-height: calc(96 / 50);
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--c-light);
    z-index: 1;
  }

  /* Figma: from x 66.44, y 469, 14.04px apart */
  .project-hero__tags {
    position: absolute;
    left: calc(66.44 * var(--u));
    top: calc(469 * var(--u));
    display: flex;
    gap: calc(14.04 * var(--u));
  }

  /* The tags are the home page's tags drawn 1.17 times bigger (37.45px tall instead of 32) */
  .project-hero__tags :global(.tag) {
    --k: calc(1.1703 * max(var(--u), var(--t-min)));
  }

  /* Figma: the summary at x 66, y 526, 508px wide */
  .project-hero__intro {
    position: absolute;
    left: calc(66 * var(--u));
    top: calc(526 * var(--u));
    width: calc(508 * var(--u));
  }

  /* Figma: Akzidenz 20px */
  .project-hero__summary {
    margin: 0;
    font-family: var(--f-sans);
    font-size: max(var(--fs-min), calc(20 * var(--t)));
    line-height: 1.2;
    color: var(--c-ink);
  }

  /* Figma: x 66, y 614 and y 679 */
  .project-hero__buttons {
    position: absolute;
    left: 0;
    top: calc((614 - 526) * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(13 * var(--u));
  }

  /*
    Below 1440 (tablets, and a zoomed page): the text can be bigger than the design, so the buttons
    follow it, 20px under it. The summary's min-height keeps them at Figma's y 614 when it fits.
  */
  @media (max-width: 1439px) {
    .project-hero__summary {
      min-height: calc((614 - 526 - 20) * var(--u));
    }

    .project-hero__buttons {
      position: static;
      margin-top: calc(20 * var(--u));
    }
  }

  /*
    ---------- Phone (< 768px), Figma 529:2153 (393px frame) ----------
    The same parts, stacked: the band with the centred name, the tags, the line about the project,
    the two buttons, then the mockup running off the right edge. Phone frame px from the top.
    Irina moved the band and everything under it up 65px from Figma (the gap under the header is
    35px instead of 100px, every other gap is unchanged), so the mockup is on the first screen.
    --hm is the hero's own phone unit: one phone pixel, but smaller on short screens, so everything
    down to the bottom of the mockup (y 702, plus 16px) fits the first screen. svh is the screen
    height with the browser bars showing. The header keeps --m.
  */
  @media (max-width: 767px) {
    .project-hero {
      --hm: var(--m);
      --hm: min(var(--m), calc(100svh / 718));
      grid-template-columns: [full-start] 1fr [frame-start] calc(393 * var(--hm)) [frame-end] 1fr [full-end];
      grid-template-rows: [content-start] calc(725 * var(--hm)) [content-end];
    }

    /* The header keeps its full phone size, centred over the hero */
    .project-hero__header {
      width: calc(393 * var(--m));
      margin-left: calc((393 * var(--hm) - 393 * var(--m)) / 2);
    }

    /* Figma: 76px tall, edge to edge (y 110, 65px higher than in Figma) */
    .project-hero__band {
      margin-top: calc(110 * var(--hm));
      height: calc(76 * var(--hm));
    }

    /* Figma: Boldonse 24px, centred on the band */
    .project-hero__title {
      left: 0;
      right: 0;
      top: calc(126 * var(--hm));
      font-size: calc(24 * var(--hm));
      text-align: center;
    }

    /* Figma: the tags at 0.81 of the home page's size, from x 8, 8px under the band, 9.73px apart */
    .project-hero__tags {
      left: calc(8 * var(--hm));
      top: calc(194 * var(--hm));
      gap: calc(9.73 * var(--hm));
    }

    .project-hero__tags :global(.tag) {
      --k: calc(0.8106 * var(--hm));
    }

    /* Figma: Akzidenz 15.6px at x 8, 297px wide, 16px under the tags */
    .project-hero__intro {
      left: calc(8 * var(--hm));
      top: calc(236 * var(--hm));
      width: calc(297 * var(--hm));
    }

    .project-hero__summary {
      min-height: 0;
      font-size: calc(15.6 * var(--hm));
    }

    /* Figma: the desktop buttons at 0.69 of their size, 16px under the text, 9px apart */
    .project-hero__buttons {
      --u: calc(0.6923 * var(--hm));
      margin-top: calc(16 * var(--hm));
      gap: calc(9 * var(--hm));
    }

    .project-hero__buttons :global(.button) {
      font-size: calc(16 * var(--u));
      border-width: calc(2 * var(--u));
    }

    /* Figma: x 8, 482.8px wide, running off the right edge, 30px under the buttons */
    .project-hero__mockup {
      left: calc(8 * var(--hm));
      top: calc(420 * var(--hm));
      width: calc(482.8 * var(--hm));
    }
  }
</style>

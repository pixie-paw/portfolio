---
import Tag from './Tag.astro';
import Button from './Button.astro';
import ArrowTop from '../assets/footer/arrow-cv-top.svg';
import ArrowBottom from '../assets/footer/arrow-cv-bottom.svg';
import { CV_FILE, hasCv } from '../data/cv';

// Checked on every render, so the link appears as soon as the PDF is added
const cvIsThere = hasCv();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
  The end of the page: four "{ If you liked what you've seen }" stickers, the DOWNLOAD CV
  block with four arrows pointing at it, the three contact buttons and the pink footer band.
  Figma pixels from the 1440px home page frame, measured from the top of this section
  (Figma y 3330, where the marquee ends). x/y = centre of the layer.
*/
const SECTION_TOP = 3330;

/*
  The CV (see src/data/cv.ts): once Irina's PDF is in the public folder, "DOWNLOAD CV" becomes
  a download link by itself. Until then it's plain text, so there's never a broken link.
*/

const STICKERS = [
  { x: 264.75, y: 3072.21, rotate: -10.48 },
  { x: 284.15, y: 3361.14, rotate: 6.2 },
  { x: 1132.63, y: 3298.53, rotate: -4.74 },
  { x: 1196.12, y: 3419.8, rotate: 7.68 },
];

/*
  The four arrows, as Figma exports them (already drawn at their angle). The right ones are
  the left ones mirrored. All four sit 163.8px either side of the page's centre line (x 720),
  like the CV block and the buttons, so the group is centred.
*/
const CENTRE_X = 720;
const ARROW_GAP_X = 163.8;
const ARROWS = [
  { Svg: ArrowTop, w: 106, x: CENTRE_X - ARROW_GAP_X, y: 3398.15, mirror: false },
  { Svg: ArrowTop, w: 106, x: CENTRE_X + ARROW_GAP_X, y: 3398.15, mirror: true },
  { Svg: ArrowBottom, w: 102, x: CENTRE_X - ARROW_GAP_X, y: 3484, mirror: false },
  { Svg: ArrowBottom, w: 102, x: CENTRE_X + ARROW_GAP_X, y: 3484, mirror: true },
];

const LINKS = [
  { text: 'Email', href: 'mailto:irinammoldovan@gmail.com', w: 131, name: 'footer-email', newTab: false },
  { text: 'LinkedIn', href: 'https://www.linkedin.com/in/irina-maria-moldovan/', w: 153, name: 'footer-linkedin', newTab: true },
  { text: 'Behance', href: 'https://www.behance.net/irinamoldovan2', w: 159, name: 'footer-behance', newTab: true },
];
---

<footer class="footer" id="contact" data-section="footer">
  <div class="footer__frame">
    <!-- Not positioned, so the stickers are still placed in the frame; it only hides them before the first paint -->
    <div class="footer__stickers" data-intro>
      {
        STICKERS.map(({ x, y, rotate }) => (
          <Tag name="footer-sticker" text="{ If you liked what you’ve seen }" x={x} y={y - SECTION_TOP} w={221} h={32} rotate={rotate} />
        ))
      }
    </div>

    {
      ARROWS.map(({ Svg, w, x, y, mirror }) => (
        <span
          class:list={['footer__arrow', mirror && 'footer__arrow--mirror']}
          data-layer="footer-arrow"
          data-intro
          style={`--x:${x};--y:${y - SECTION_TOP};--w:${w}`}
          aria-hidden="true"
        >
          <Svg class="footer__arrow-svg" data-layer="footer-arrow-svg" />
        </span>
      ))
    }

    <!-- DOWNLOAD CV, with the yellow bar behind "CV" -->
    {
      cvIsThere ? (
        <a class="footer__cv" href={`${base}/${CV_FILE}`} download data-layer="footer-cv" data-intro>
          <span class="footer__cv-marker" data-layer="footer-cv-marker" />
          <span class="footer__cv-download" data-layer="footer-cv-download">Download</span>
          <span class="footer__cv-letters" data-layer="footer-cv-letters">CV</span>
        </a>
      ) : (
        <div class="footer__cv" data-layer="footer-cv" data-intro>
          <span class="footer__cv-marker" data-layer="footer-cv-marker" />
          <span class="footer__cv-download" data-layer="footer-cv-download">Download</span>
          <span class="footer__cv-letters" data-layer="footer-cv-letters">CV</span>
        </div>
      )
    }

    <nav class="footer__links" aria-label="Contact" data-layer="footer-links" data-intro>
      {LINKS.map((link) => <Button {...link} class="footer__button" />)}
    </nav>
  </div>

  <!-- The pink band runs edge to edge -->
  <div class="footer__band" data-layer="footer-band">
    <div class="footer__band-frame" data-layer="footer-band-texts" data-intro>
      <p class="footer__band-text" data-layer="footer-name">Irina’s portfolio</p>
      <p class="footer__band-text footer__band-text--centre" data-layer="footer-by">by Irina Moldovan</p>
      <p class="footer__band-text footer__band-text--end" data-layer="footer-rights">© All rights reserved</p>
    </div>
  </div>
</footer>

<style>
  /*
    Desktop: the 1440 Figma frame sits in the middle column. The outer 1fr columns
    are 0 up to 1440px and centre the frame above it. Only the pink band runs edge to edge.
  */
  .footer {
    position: relative;
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    grid-template-rows: [content-start] calc(445 * var(--u)) [band-start] calc(91 * var(--u)) [band-end];
  }

  .footer__frame {
    grid-column: frame;
    grid-row: content;
    position: relative;
  }

  /* ---------- Arrows ---------- */
  .footer__arrow {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    translate: -50% -50%;
    color: var(--c-ink);
  }

  .footer__arrow--mirror {
    scale: -1 1;
  }

  .footer__arrow-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- DOWNLOAD CV ---------- */
  /* Centred on the page's centre line (x 720), like the arrows and the buttons */
  .footer__cv {
    position: absolute;
    left: calc((720 - 85) * var(--u));
    top: calc((3338 - 3330) * var(--u));
    width: calc(170 * var(--u));
    height: calc((3486.5 - 3338) * var(--u));
    color: var(--c-ink);
  }

  .footer__cv-download,
  .footer__cv-letters {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
  }

  .footer__cv-download {
    top: 0;
    font-family: var(--f-display);
    font-size: calc(18 * var(--u));
    line-height: calc(35 * var(--u));
    white-space: nowrap;
  }

  .footer__cv-letters {
    top: calc((3358 - 3338) * var(--u));
    font-family: var(--f-display);
    font-size: calc(78 * var(--u));
    line-height: calc(150 * var(--u));
    white-space: nowrap;
    z-index: 1;
  }

  /* The yellow bar: 170 x 23px, centred on Figma y 3475, behind the letters */
  .footer__cv-marker {
    position: absolute;
    left: 0;
    top: calc((3475 - 11.5 - 3338) * var(--u));
    width: 100%;
    height: calc(23 * var(--u));
    background: var(--c-marker);
  }

  /* ---------- Contact buttons ---------- */
  /* Figma: from x 472 at y 3574, 26px apart */
  .footer__links {
    position: absolute;
    left: calc(472 * var(--u));
    top: calc((3574 - 3330) * var(--u));
    display: flex;
    gap: calc(26 * var(--u));
  }

  /* ---------- Pink band ---------- */
  .footer__band {
    grid-column: full;
    grid-row: band;
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    background: var(--c-pink);
  }

  /* The three texts sit at Figma x 100, the centre (x 647) and the right (ending at x 1341), at y 3812 */
  .footer__band-frame {
    grid-column: frame;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'start centre end';
    align-items: center;
    padding: 0 calc(99 * var(--u)) 0 calc(100 * var(--u));
  }

  .footer__band-text {
    grid-area: start;
    margin: 0;
    font-family: var(--f-display);
    font-size: calc(14 * var(--u));
    line-height: calc(27 * var(--u));
    white-space: nowrap;
    color: var(--c-ink);
  }

  .footer__band-text--centre {
    grid-area: centre;
  }

  .footer__band-text--end {
    grid-area: end;
    justify-self: end;
  }
</style>

---
import { Image } from 'astro:assets';
import { WAVE_POINTS, WAVE_TEXT, smoothPath, shiftPoints, lengthUpTo } from '../data/wave';

import camera from '../assets/about-page/camera-pink.webp';
import cameraPhoto from '../assets/about-page/camera-photo.webp';
import strip from '../assets/about-page/photo-strip.webp';
import FlowerCardStem from '../assets/about-page/flower-card-stem.svg';

/*
  The About me page, section 2: "How it started". Figma pixels from the 1440px
  "3.0 About page" frame, measured from the top of this section (Figma y 1000, where section 1
  ends). Some layers start higher, in section 1: the stem grows down from section 1's text
  card, and the camera and its photos sit beside it.
*/
const SECTION_TOP = 1000;

// x / y = top-left corner, w / h = size, r = tilt (Figma turns the other way, so its sign is flipped)
const place = (x: number, y: number, w: number, h = 0, r = 0) =>
  `--x:${x};--y:${y - SECTION_TOP};--w:${w};--h:${h};--r:${r}deg`;

/*
  The wave text, without the blue line on this page: the home page's curve, 25px to the right
  and 4.5px lower (Figma's text path starts at x -170, y 1323.7 here).
*/
const TEXT_POINTS = shiftPoints(WAVE_POINTS, 25, 146.5 - 142);
const TEXT_START_X = -170;
const textPath = smoothPath(TEXT_POINTS, SECTION_TOP);
const textStartOffset = lengthUpTo(TEXT_POINTS, TEXT_START_X);
const WAVE_BOX = { x: -800, y: 100, w: 3040, h: 820 };
---

<section class="how-started" aria-labelledby="how-started-title" data-section="how-started">
  <!-- The words flowing along the wave, edge to edge, behind everything else -->
  <svg
    class="how-started__wave"
    data-layer="how-started-wave"
    viewBox={`${WAVE_BOX.x} ${WAVE_BOX.y} ${WAVE_BOX.w} ${WAVE_BOX.h}`}
    style={`--wx:${WAVE_BOX.x};--wy:${WAVE_BOX.y};--ww:${WAVE_BOX.w};--wh:${WAVE_BOX.h}`}
    aria-hidden="true"
  >
    <path id="how-started-wave-path" d={textPath} fill="none" />
    <text class="how-started__wave-text" data-layer="wave-text" xml:space="preserve">
      <textPath href="#how-started-wave-path" data-layer="wave-text-path" startOffset={textStartOffset.toFixed(1)}>{WAVE_TEXT}</textPath>
    </text>
  </svg>

  <div class="how-started__frame">
    <!--
      The stem grows down from section 1's text card to a red flower beside the camera.
      The same SVG is placed twice: once showing only the stem, under the cards (so it comes out
      from behind section 1's card), and once showing only the flower, above them.
    -->
    <span
      class="how-started__layer how-started__stem"
      data-layer="how-started-flower"
      data-intro
      data-grow="start"
      style={place(590.25, 645.45, 316)}
    >
      <FlowerCardStem />
    </span>
    <span
      class="how-started__layer how-started__bloom"
      data-layer="how-started-bloom"
      data-intro
      aria-hidden="true"
      style={place(590.25, 645.45, 316)}
    >
      <FlowerCardStem />
    </span>

    <!--
      The camera with a photo on its screen, and a strip of two pictures behind it. Each sits in a
      wrapper that holds its Figma place and tilt; the image inside is what moves.
    -->
    <span class="how-started__layer how-started__strip" data-intro style={place(913.86, 931, 136.61, 374.79, 4.88)}>
      <Image
        class="how-started__image"
        data-layer="how-started-strip"
        src={strip}
        alt="A strip of two small pictures"
        widths={[137, 273]}
        sizes="137px"
      />
    </span>
    <span class="how-started__layer how-started__photo" data-intro style={place(960, 762.11, 179.23, 238.98, -11.95)}>
      <Image
        class="how-started__image"
        data-layer="how-started-photo"
        src={cameraPhoto}
        alt=""
        widths={[179, 358]}
        sizes="179px"
      />
    </span>
    <span class="how-started__layer how-started__camera" data-intro style={place(958, 776.98, 271.53, 176.59, -6.13)}>
      <Image
        class="how-started__image"
        data-layer="how-started-camera"
        src={camera}
        alt="Irina’s pink camera"
        widths={[272, 543]}
        sizes="272px"
      />
    </span>

    <h2 class="how-started__title" id="how-started-title" data-layer="how-started-title" data-intro>HOW IT STARTED</h2>

    <!-- Text card with corner brackets -->
    <div class="how-started__card" data-layer="how-started-card" data-intro>
      <p class="how-started__text" data-layer="how-started-text">
        It took me a while to find my way here. As a kid, I spent quite a bit of time
        <strong> drawing and sewing</strong>, but somewhere along the way, I left those things behind. After
        <strong> trying out a few jobs and realising that something was missing</strong>, I started looking for
        creative study programmes in Belgium. Then I found Howest. The mix of
        <strong> design, technology and experimental projects caught my attention</strong>, and I decided to give it
        a shot. Looking back, it’s one of the best decisions I’ve made.
      </p>
      <span class="how-started__corner how-started__corner--tl" data-layer="how-started-corner"></span>
      <span class="how-started__corner how-started__corner--tr" data-layer="how-started-corner"></span>
      <span class="how-started__corner how-started__corner--bl" data-layer="how-started-corner"></span>
      <span class="how-started__corner how-started__corner--br" data-layer="how-started-corner"></span>
    </div>
  </div>
</section>

<style>
  /*
    Desktop: the 1440 Figma frame sits in the middle column. The outer 1fr columns
    are 0 up to 1440px and centre the frame above it. Only the wave text runs edge to edge.
  */
  .how-started {
    position: relative;
    display: grid;
    grid-template-columns: [full-start] 1fr [frame-start] calc(1440 * var(--u)) [frame-end] 1fr [full-end];
    grid-template-rows: [content-start] calc(520 * var(--u)) [content-end];
    /* the wave text is wider than the screen: clip it sideways only */
    overflow-x: clip;
  }

  .how-started__frame {
    grid-column: frame;
    grid-row: content;
    position: relative;
  }

  /* ---------- Wave text ---------- */
  .how-started__wave {
    position: absolute;
    left: calc(50% + (var(--wx) - 720) * var(--u));
    top: calc(var(--wy) * var(--u));
    width: calc(var(--ww) * var(--u));
    height: calc(var(--wh) * var(--u));
    overflow: visible;
    pointer-events: none;
  }

  .how-started__wave-text {
    fill: var(--c-blue);
    font-family: var(--f-inter);
    font-size: 24px;
    white-space: pre;
  }

  /* ---------- Collage layers ---------- */
  /* Placed from their top-left corner and tilted around it, like Figma does */
  .how-started__layer {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    transform-origin: 0 0;
    rotate: var(--r);
  }

  .how-started__strip,
  .how-started__photo,
  .how-started__camera {
    height: calc(var(--h) * var(--u));
  }

  .how-started__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .how-started__layer :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Under section 1's text card, so the stem comes out from behind it */
  .how-started__stem {
    z-index: 1;
  }

  .how-started__stem :global([data-layer='flower-head']) {
    display: none;
  }

  /* The flower, above this section's text card */
  .how-started__bloom {
    z-index: 5;
    pointer-events: none;
  }

  .how-started__bloom :global([data-layer='flower-stem']) {
    display: none;
  }

  .how-started__strip {
    z-index: 2;
  }

  .how-started__photo {
    z-index: 3;
  }

  .how-started__camera {
    z-index: 4;
  }

  .how-started__camera .how-started__image {
    filter: drop-shadow(calc(-3.28 * var(--u)) calc(3.28 * var(--u)) calc(2.19 * var(--u)) oklch(26.16% 0.0296 267.48 / 0.1));
  }

  /* ---------- Title ---------- */
  .how-started__title {
    position: absolute;
    left: calc(142 * var(--u));
    top: calc((1017 - 1000) * var(--u));
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: calc(48 * var(--u));
    line-height: 1.4;
    white-space: nowrap;
    color: var(--c-ink);
    z-index: 3;
  }

  /* ---------- Text card ---------- */
  .how-started__card {
    position: absolute;
    left: calc(100 * var(--u));
    top: calc((1063 - 1000) * var(--u));
    width: calc(702 * var(--u));
    height: calc(243 * var(--u));
    padding: calc(37 * var(--u)) calc(41 * var(--u)) 0 calc(42 * var(--u));
    background: var(--c-light);
    z-index: 2;
  }

  .how-started__text {
    margin: 0;
    font-family: var(--f-sans);
    font-size: calc(20 * var(--u));
    line-height: 1.2;
    color: var(--c-ink);
  }

  .how-started__text strong {
    font-weight: 500;
  }

  .how-started__corner {
    position: absolute;
    width: calc(12 * var(--u));
    height: calc(14 * var(--u));
    border: 0 solid var(--c-ink);
    --stroke: max(1.5px, calc(2.5 * var(--u)));
  }

  .how-started__corner--tl {
    top: 0;
    left: 0;
    border-top-width: var(--stroke);
    border-left-width: var(--stroke);
  }

  .how-started__corner--tr {
    top: 0;
    right: 0;
    border-top-width: var(--stroke);
    border-right-width: var(--stroke);
  }

  .how-started__corner--bl {
    bottom: 0;
    left: 0;
    border-bottom-width: var(--stroke);
    border-left-width: var(--stroke);
  }

  .how-started__corner--br {
    bottom: 0;
    right: 0;
    border-bottom-width: var(--stroke);
    border-right-width: var(--stroke);
  }
</style>

---
/**
 * The green button with a text and an arrow (Get in touch, About me, Email, LinkedIn, Behance).
 * On hover the letters and the arrow roll up into a light copy (see animations.ts).
 *
 * href  = where it goes.
 * text  = the label, written as in Figma (the CSS makes it uppercase).
 * w     = width in Figma pixels.
 * name  = its data-layer name.
 * newTab = opens in a new tab (for links to other sites, like LinkedIn).
 * tone  = 'green' (the default) or 'dark' (ink with light text, like Read the process).
 * download = downloads the file it links to (the CV) instead of opening it.
 */
import Arrow from '../assets/home/svg/arrow.svg';

interface Props {
  href: string;
  text: string;
  w: number;
  name: string;
  class?: string;
  intro?: boolean;
  newTab?: boolean;
  tone?: 'green' | 'dark';
  download?: boolean;
}

const { href, text, w, name, class: className, intro = false, newTab = false, tone = 'green', download = false } = Astro.props;
---

<!-- Two copies of the text and the arrow: on hover the dark one rolls up and out, the light one rolls in -->
<a
  class:list={['button', tone === 'dark' && 'button--dark', className]}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
  download={download ? '' : undefined}
  data-layer={name}
  data-roll-button
  data-intro={intro ? '' : undefined}
  style={`--w:${w}`}
>
  <span class="button__roll">
    <span class="button__label" data-layer="button-text">{text}</span>
    <span class="button__label button__label--hover" data-layer="button-text-hover" aria-hidden="true">{text}</span>
  </span>
  <span class="button__roll" aria-hidden="true">
    <Arrow class="button__arrow" data-layer="button-arrow" />
    <Arrow class="button__arrow button__arrow--hover" data-layer="button-arrow-hover" />
  </span>
  <!-- Screen readers hear that the link opens a new tab -->
  {newTab && <span class="visually-hidden">(opens in a new tab)</span>}
</a>

<style>
  /*
    --bu: the button's own unit. It's --u, but never smaller than one pixel at the browser's text
    size (--t-min), so the button and its text grow when the page is zoomed (see global.css).
  */
  .button {
    --bu: max(var(--u), var(--t-min));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(10 * var(--bu));
    height: calc(52 * var(--bu));
    width: calc(var(--w) * var(--bu));
    background: var(--c-green);
    border: 2px solid var(--c-ink);
    font-family: var(--f-display);
    font-size: max(var(--fs-min-small), calc(16 * var(--bu)));
    text-transform: uppercase;
    color: var(--c-ink);
  }

  /*
    A window the letters roll through. The padding gives the tall Boldonse
    letters room, and the negative margin keeps the button the same size.
  */
  .button__roll {
    position: relative;
    display: block;
    overflow: hidden;
    padding-block: 0.2em;
    margin-block: -0.2em;
  }

  .button__label {
    display: block;
    line-height: 1.2;
  }

  .button__label--hover,
  .button__arrow--hover {
    position: absolute;
    left: 0;
    top: 0.2em;
    color: var(--c-light);
    /* shown by the script once it has moved them below the window */
    visibility: hidden;
  }

  /* Ink button with light text and arrow */
  .button--dark {
    background: var(--c-ink);
    color: var(--c-light);
  }

  .button__arrow {
    display: block;
    width: calc(18 * var(--bu));
    height: auto;
  }

  .button__arrow--hover {
    top: auto;
    bottom: 0.2em;
  }

  /* Tablet: the text has a minimum size, so the button grows with it instead of cutting it */
  @media (max-width: 1023px) {
    .button {
      width: max-content;
      min-width: calc(var(--w) * var(--bu));
      padding-inline: 12px;
    }
  }
</style>

---
import '../styles/global.css';
import gridPaper from '../assets/home/grid-paper.webp';
import texture from '../assets/home/texture.webp';
// The flower logo, cropped close to its edges so it fills the browser tab
import faviconUrl from '../assets/favicon.svg?url';
import Flower from '../assets/home/svg/logo-flower.svg';

interface Props {
  title: string;
  description?: string;
  // The id of the page's main title: the skip link jumps there, past the header
  skipTo: string;
}

const {
  title,
  description = 'Irina Moldovan, Digital Designer and Developer, studying Digital Design and Development at Howest.',
  skipTo,
} = Astro.props;
import Loader from '../components/Loader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Favicon: the yellow flower from the header. The PNG is for iPhone home screens, which don't use SVG icons -->
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <!-- Akzidenz-Grotesk Next + Bulletin Typewriter MN from Irina's Adobe Fonts web project -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/uit2fga.css" />
    <!--
      Hide the page-load layers before the first paint, so they don't flash before
      the animation starts. Skipped for reduced motion. If the animation script never
      runs, the layers show anyway after 4s.
    -->
    <!--
      The loading screen shows every time a page is loaded fresh (a first visit, a refresh, a link
      from elsewhere), but not when it's reached through the site's own links, which have the tape
      strips. It's decided here, before the first paint, so the page never flashes before it.
      If the script never runs, it goes after 12s.
    -->
    <script is:inline>
      let fromTransition = false;
      try {
        fromTransition = Boolean(sessionStorage.getItem('page-transition'));
      } catch (error) {
        // no sessionStorage: treat it as a fresh load
      }
      if (!fromTransition) {
        const $html = document.documentElement;
        $html.dataset.loader = 'on';
        setTimeout(() => delete $html.dataset.loader, 12000);
      }
    </script>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const $html = document.documentElement;
        $html.dataset.intro = 'pending';
        // longer when the loading screen plays first
        setTimeout(() => delete $html.dataset.intro, $html.dataset.loader === 'on' ? 12000 : 4000);
      }
    </script>
    <!--
      Page transitions: when the last page left through a transition, this page starts covered by
      the tape strips in that colour, before the first paint, and animations.ts reveals it. If the
      script never runs, the strips come away anyway after 2s.
    -->
    <script is:inline>
      try {
        const colour = sessionStorage.getItem('page-transition');
        if (colour) {
          const $html = document.documentElement;
          $html.dataset.transition = 'in';
          $html.style.setProperty('--transition-colour', colour);
          setTimeout(() => delete $html.dataset.transition, 2000);
        }
      } catch (error) {
        // no sessionStorage (private mode): no transition, the page simply shows
      }
    </script>
  </head>
  <body style={`--paper-url: url(${gridPaper.src}); --texture-url: url(${texture.src})`}>
    <!-- For keyboard and screen reader users: hidden until it gets focus, then jumps past the header -->
    <a class="skip-link" href={`#${skipTo}`} data-skip-link>Skip to content</a>
    <slot />
    <!-- The loading screen, on every fresh page load (see Loader.astro and animations.ts) -->
    <Loader />
    <!-- The page transition: five tape strips that cover the screen between pages (see animations.ts) -->
    <div class="page-transition" aria-hidden="true" data-page-transition>
      {Array.from({ length: 5 }, (_, i) => <span class="page-transition__strip" style={`--i:${i}`} data-transition-strip />)}
    </div>
    <!-- The yellow flower from the logo follows the mouse across the whole site (desktop only, see animations.ts) -->
    <span class="cursor-flower" data-layer="cursor-flower" aria-hidden="true">
      <Flower class="cursor-flower__svg" />
    </span>
    <script>
      import { initAnimations } from '../scripts/animations';
      initAnimations();
    </script>
  </body>
</html>

---
import '../styles/global.css';
import gridPaper from '../assets/home/grid-paper.webp';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Irina Moldovan, Digital Designer and Developer, studying Digital Design and Development at Howest.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body style={`--paper-url: url(${gridPaper.src})`}>
    <slot />
    <script>
      import { initAnimations } from '../scripts/animations';
      initAnimations();
    </script>
  </body>
</html>
